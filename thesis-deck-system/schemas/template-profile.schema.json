{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "template-profile.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "source_path", "source_sha256", "slide_size", "masters", "layouts", "theme", "semantic_roles", "created_at"],
  "properties": {"schema_version": {"const": "1.0.0"}, "profile_id": {"type":"string","pattern": "^TP-"}, "version": {"type":"string","pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "source_path": {"type": "string","pattern":"^(?!/)(?![A-Za-z]:)(?!\\\\)"}, "source_sha256": {"type":"string","pattern": "^[0-9a-f]{64}$"}, "slide_size": {"type": "object", "required": ["width_emu", "height_emu", "aspect_ratio"]}, "masters": {"type": "array", "minItems": 1}, "layouts": {"type": "array", "minItems": 2}, "theme": {"type": "object", "required": ["major_fonts", "minor_fonts", "colors"]}, "semantic_roles": {"type": "object", "required": ["photo_observation", "hero_plot_discussion"],"additionalProperties":false,"properties":{"photo_observation":{"$ref":"#/$defs/role"},"hero_plot_discussion":{"$ref":"#/$defs/role"}}}, "created_at": {"type":"string","format": "date-time"}},
  "$defs":{"role":{"type":"object","additionalProperties":false,"required":["layout_index","layout_path","required_placeholders"],"properties":{"layout_index":{"type":"integer","minimum":0},"layout_path":{"type":"string","pattern":"^ppt/slideLayouts/"},"required_placeholders":{"type":"array","items":{"type":"string"}}}}}
}
