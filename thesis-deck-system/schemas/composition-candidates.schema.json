{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://thesis-deck-system.local/schemas/composition-candidates.schema.json","type":"object","additionalProperties":false,"required":["planner_version","records"],"properties":{"planner_version":{"const":"1.0.0"},"records":{"type":"array","items":{"$ref":"#/$defs/record"}}},"$defs":{"record":{"type":"object","additionalProperties":false,"required":["candidate_id","slide_id","content_shape_sha256","capability_id","body_family_id","score","candidate_status"],"properties":{"candidate_id":{"type":"string","pattern":"^CC-[A-F0-9]{16}$"},"slide_id":{"type":"string","minLength":1},"content_shape_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"capability_id":{"type":"string","pattern":"^LCD-[A-Z0-9-]+$"},"body_family_id":{"type":"string","pattern":"^BCF-[A-Z0-9-]+$"},"score":{"type":"object","additionalProperties":false,"required":["semantic_fit","capacity_fit","historical_consistency","bounded_diversity","hard_capacity_match","total"],"properties":{"semantic_fit":{"type":"integer"},"capacity_fit":{"type":"integer"},"historical_consistency":{"type":"integer"},"bounded_diversity":{"type":"integer"},"hard_capacity_match":{"type":"boolean"},"total":{"type":"integer"}}},"candidate_status":{"const":"eligible"}}}}}
