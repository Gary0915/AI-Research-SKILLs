{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "body-style-recipe-registry.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "registry_id", "recipes"],
  "properties": {"schema_version": {"const": "1.0.0"}, "registry_id": {"const": "BSR-REG-001"}, "recipes": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/recipe"}}},
  "$defs": {
    "theme": {"enum": ["background", "foreground", "muted", "border", "caption_background", "accent_primary", "focus", "warning", "measurement_reference"]},
    "treatment": {"type": "object", "additionalProperties": false, "properties": {"color_role": {"$ref": "#/$defs/theme"}, "border_role": {"$ref": "#/$defs/theme"}, "typography_role": {"type": "string", "pattern": "^[a-z_]+$"}, "spacing_token": {"type": "string", "pattern": "^[a-z_]+$"}, "header_color_role": {"$ref": "#/$defs/theme"}, "body_color_role": {"$ref": "#/$defs/theme"}, "padding_token": {"type": "string", "pattern": "^[a-z_]+$"}}},
    "recipe": {"type": "object", "additionalProperties": false, "required": ["body_style_recipe_id", "body_family_id", "style_recipe_version", "spacing_scale_id", "source_evidence_ids", "evidence_status", "panel_treatment", "visual_frame_treatment", "caption_treatment", "citation_treatment", "metric_callout_treatment", "table_treatment", "equation_treatment", "focus_annotation", "connector_roles", "section_divider", "supporting_context_treatment", "hierarchy"], "properties": {"body_style_recipe_id": {"type": "string", "pattern": "^BSR-"}, "body_family_id": {"type": "string", "pattern": "^BCF-"}, "style_recipe_version": {"const": "1.0.0"}, "spacing_scale_id": {"const": "PSS-001"}, "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}}, "evidence_status": {"const": "body_reference_supported"}, "panel_treatment": {"$ref": "#/$defs/treatment"}, "visual_frame_treatment": {"$ref": "#/$defs/treatment"}, "caption_treatment": {"$ref": "#/$defs/treatment"}, "citation_treatment": {"$ref": "#/$defs/treatment"}, "metric_callout_treatment": {"$ref": "#/$defs/treatment"}, "table_treatment": {"$ref": "#/$defs/treatment"}, "equation_treatment": {"$ref": "#/$defs/treatment"}, "focus_annotation": {"$ref": "#/$defs/treatment"}, "connector_roles": {"type": "object", "additionalProperties": false, "required": ["major", "warning", "measurement"], "properties": {"major": {"$ref": "#/$defs/theme"}, "warning": {"$ref": "#/$defs/theme"}, "measurement": {"$ref": "#/$defs/theme"}}}, "section_divider": {"$ref": "#/$defs/treatment"}, "supporting_context_treatment": {"$ref": "#/$defs/treatment"}, "hierarchy": {"type": "object", "additionalProperties": false, "required": ["primary", "secondary", "supporting", "caption", "metric", "decision"], "properties": {"primary": {"type": "string"}, "secondary": {"type": "string"}, "supporting": {"type": "string"}, "caption": {"type": "string"}, "metric": {"type": "string"}, "decision": {"type": "string"}}}}}
  }
}
