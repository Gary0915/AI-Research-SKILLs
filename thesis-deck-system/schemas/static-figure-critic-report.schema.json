{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"static-figure-critic-report.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","critic_report_id","manifest_id","status","executed","checks"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"critic_report_id":{"type":"string"},"manifest_id":{"type":"string"},
    "status":{"enum":["APPROVED_FIGURE","FAIL","BLOCKED"]},"executed":{"const":true},
    "checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["check_id","status","facts"],"properties":{"check_id":{"pattern":"^C0-[0-9]{2}$"},"status":{"enum":["pass","fail","blocked"]},"facts":{"type":"object","additionalProperties":{"type":["string","integer","boolean","array","null"]}}}}}
  }
}
