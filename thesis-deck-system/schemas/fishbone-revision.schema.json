{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "fishbone-revision.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "fishbone_id", "revision", "branches", "linked_hypothesis_layers", "rationale", "source_event_cursor", "created_at"],
  "properties": {"schema_version": {"const": "2.0.0"}, "fishbone_id": {"type": "string", "pattern": "^FB[0-9]{3}$"}, "revision": {"type": "integer", "minimum": 1}, "supersedes_revision": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}, "branches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/branch"}}, "linked_hypothesis_layers": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^H[0-9]{3}$"}}, "rationale": {"type": "string", "minLength": 1}, "source_event_cursor": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}},
  "$defs": {"branch": {"type": "object", "additionalProperties": false, "required": ["branch_id", "label", "parent_ref", "status"], "properties": {"branch_id": {"type": "string", "pattern": "^FB-[A-Z0-9-]+$"}, "label": {"type": "string", "minLength": 1}, "parent_ref": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^FB-[A-Z0-9-]+$"}]}, "status": {"type": "string", "enum": ["current", "completed", "failed_but_informative", "partial", "future", "superseded"]}, "mechanism_refs": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3,}$"}}, "strategy_refs": {"type": "array", "items": {"type": "string", "pattern": "^B[0-9]{3,}$"}}}}}
}
