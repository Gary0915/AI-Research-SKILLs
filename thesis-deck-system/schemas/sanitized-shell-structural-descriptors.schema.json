{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanitized-shell-structural-descriptors.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "descriptors"],
  "properties": {"schema_version": {"const": "1.0.0"}, "descriptors": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/descriptor"}}},
  "$defs": {
    "geometry": {"type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h", "basis"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}},
    "topology": {"type": "object", "additionalProperties": false, "required": ["source_id", "target_id", "basis"], "properties": {"source_id": {"type": "string", "pattern": "^[MLD][0-9]{3,}$"}, "target_id": {"type": "string", "pattern": "^[MLD][0-9]{3,}$"}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}},
    "shell_primitive": {"type": "object", "additionalProperties": false, "required": ["primitive_id", "primitive_class", "geometry", "recurrence_count", "basis"], "properties": {"primitive_id": {"type": "string", "pattern": "^S[0-9]{3,}$"}, "primitive_class": {"enum": ["text_region", "picture", "table_or_chart", "native_shape", "connector", "group", "unknown"]}, "geometry": {"$ref": "#/$defs/geometry"}, "recurrence_count": {"type": "integer", "minimum": 1}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}},
    "region": {"type": "object", "additionalProperties": false, "required": ["region_id", "role", "geometry", "basis", "recurrence_count"], "properties": {"region_id": {"type": "string", "pattern": "^R[0-9]{3,}$"}, "role": {"enum": ["title", "header", "footer", "page_number", "navigation", "safe_content", "unknown"]}, "geometry": {"$ref": "#/$defs/geometry"}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}, "recurrence_count": {"type": "integer", "minimum": 1}}},
    "font_role": {"type": "object", "additionalProperties": false, "required": ["role", "family", "size_pt", "weight", "style", "basis"], "properties": {"role": {"enum": ["title", "body", "caption", "footer", "unknown"]}, "family": {"enum": ["Arial", "Calibri", "Times New Roman", "Aptos", "Noto Sans CJK", "Microsoft JhengHei", "other_approved"]}, "size_pt": {"type": "number", "exclusiveMinimum": 0, "maximum": 200}, "weight": {"enum": ["regular", "bold", "unknown"]}, "style": {"enum": ["normal", "italic", "unknown"]}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}},
    "style_role": {"type": "object", "additionalProperties": false, "required": ["role", "fill_role", "stroke_role", "line_width_pt", "basis"], "properties": {"role": {"enum": ["background", "neutral", "accent", "emphasis", "unknown"]}, "fill_role": {"enum": ["none", "background", "neutral", "accent", "emphasis", "unknown"]}, "stroke_role": {"enum": ["none", "neutral", "accent", "emphasis", "unknown"]}, "line_width_pt": {"type": "number", "minimum": 0, "maximum": 20}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}},
    "descriptor": {"type": "object", "additionalProperties": false, "required": ["alias_uri", "source_sha256", "profile_id", "slide_size", "master_count", "layout_count", "shell_primitives", "slide_count", "measurement_basis", "layout_master_topology", "slide_layout_topology", "shell_regions", "safe_content_bounds", "typography_roles", "style_roles"], "properties": {"alias_uri": {"type": "string", "enum": ["private://template_primary_1", "private://template_primary_3"]}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "profile_id": {"type": "string", "pattern": "^P3-[A-Z0-9-]+$"}, "slide_size": {"type": "object", "additionalProperties": false, "required": ["width", "height", "basis"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}}, "master_count": {"type": "integer", "minimum": 0}, "layout_count": {"type": "integer", "minimum": 0}, "slide_count": {"type": "integer", "minimum": 1}, "measurement_basis": {"type": "object", "additionalProperties": false, "required": ["slide_size", "topology", "regions", "typography", "styles", "primitives"], "properties": {"slide_size": {"enum": ["measured", "derived", "not_observable_structurally"]}, "topology": {"enum": ["measured", "derived", "not_observable_structurally"]}, "regions": {"enum": ["measured", "derived", "not_observable_structurally"]}, "typography": {"enum": ["measured", "derived", "not_observable_structurally"]}, "styles": {"enum": ["measured", "derived", "not_observable_structurally"]}, "primitives": {"enum": ["measured", "derived", "not_observable_structurally"]}}}, "layout_master_topology": {"type": "array", "items": {"$ref": "#/$defs/topology"}}, "slide_layout_topology": {"type": "array", "items": {"$ref": "#/$defs/topology"}}, "shell_regions": {"type": "array", "items": {"$ref": "#/$defs/region"}}, "safe_content_bounds": {"$ref": "#/$defs/geometry"}, "typography_roles": {"type": "array", "items": {"$ref": "#/$defs/font_role"}}, "style_roles": {"type": "array", "items": {"$ref": "#/$defs/style_role"}}, "shell_primitives": {"type": "array", "items": {"$ref": "#/$defs/shell_primitive"}}}}
  }
}
