{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "layer-summary.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "summary_id", "hypothesis_layer_ref", "answered", "supporting_evidence_refs", "remaining_unresolved", "hypothesis_status", "decision_ref", "next_question", "next_step_refs", "source_event_cursor", "created_at"],
  "properties": {"schema_version": {"const": "2.0.0"}, "summary_id": {"type": "string", "pattern": "^SUM-H[0-9]{3}$"}, "hypothesis_layer_ref": {"type": "string", "pattern": "^H[0-9]{3}$"}, "answered": {"type": "string", "minLength": 1}, "supporting_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(E|RES)[0-9]{3,}$"}}, "remaining_unresolved": {"type": "string", "minLength": 1}, "hypothesis_status": {"type": "string", "enum": ["supported", "partial_support", "rejected", "inconclusive"]}, "decision_ref": {"type": "string", "pattern": "^D[0-9]{3,}$"}, "next_question": {"type": "string", "minLength": 1}, "next_step_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^NS[0-9]{3,}$"}}, "source_event_cursor": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}}
}
