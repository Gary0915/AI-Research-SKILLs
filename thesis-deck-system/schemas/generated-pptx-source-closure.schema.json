{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis-deck-system.local/schemas/generated-pptx-source-closure.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_closure_id", "input_records", "input_record_count", "unresolved_input_count", "private_input_count", "source_closure_sha256"],
  "properties": {
    "source_closure_id": {"type": "string", "pattern": "^FEC-SOURCE-CLOSURE-[A-F0-9]{12}$"},
    "input_records": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "input_record_count": {"type": "integer", "minimum": 0},
    "unresolved_input_count": {"const": 0},
    "private_input_count": {"const": 0},
    "source_closure_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input": {"type": "object", "additionalProperties": false, "required": ["input_id", "repository_relative_path", "input_class", "producer_id", "input_role", "source_kind", "privacy_status", "input_sha256"], "properties": {
      "input_id": {"type": "string", "pattern": "^SRC-[0-9]{3}$"},
      "repository_relative_path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+$"},
      "input_class": {"type": "string", "pattern": "^[a-z_]{3,64}$"},
      "producer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
      "input_role": {"enum": ["direct_build_input", "media_source"]},
      "source_kind": {"enum": ["repository_canonical", "repository_sanitized"]},
      "privacy_status": {"const": "sanitized"},
      "input_sha256": {"$ref": "#/$defs/hash"}
    }}
  }
}
