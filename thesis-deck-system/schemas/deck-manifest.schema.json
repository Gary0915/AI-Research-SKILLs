{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "deck-manifest.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "deck_id", "deck_kind", "title", "template_profile_ref", "professor_profile_ref", "source_event_cursor", "build_id", "build_tool_version", "created_at", "projection", "slides", "outputs", "qa_report_refs"],
  "properties": {"schema_version": {"const": "1.0.0"}, "deck_id": {"type": "string"}, "deck_kind": {"enum": ["master", "meeting", "defense"]}, "title": {"type": "string"}, "template_profile_ref": {"type": "object", "required": ["profile_id", "version"]}, "professor_profile_ref": {"type": "object", "required": ["profile_id", "version"]}, "source_event_cursor": {"type": "integer", "minimum": 1}, "build_id": {"type": "string"}, "build_tool_version": {"type": "string"}, "created_at": {"type":"string","format": "date-time"}, "projection": {"type": "object"}, "slides": {"type": "array", "minItems": 2,"items":{"type":"object","additionalProperties":false,"required":["ordinal","slide_id","slide_spec_path","slide_spec_sha256","block_ref","claim_refs","evidence_refs","asset_refs","action_refs","professor_profile_ref","template_profile_ref","source_event_cursor","story_visibility"],"properties":{"ordinal":{"type":"integer","minimum":1},"slide_id":{"type":"string","pattern":"^S-"},"slide_spec_path":{"type":"string","pattern":"^(?!/)(?![A-Za-z]:)(?!\\\\)"},"slide_spec_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"block_ref":{"type":"object"},"claim_refs":{"type":"array"},"evidence_refs":{"type":"array"},"asset_refs":{"type":"array"},"action_refs":{"type":"array"},"professor_profile_ref":{"type":"object"},"template_profile_ref":{"type":"object"},"source_event_cursor":{"type":"integer","minimum":1},"story_visibility":{"type":"string"}}}}, "outputs": {"type": "object", "required": ["pptx", "pptx_sha256"],"properties":{"pptx":{"type":"string","pattern":"^(?!/)(?![A-Za-z]:)(?!\\\\)"},"pptx_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}, "qa_report_refs": {"type": "array"}}
}
