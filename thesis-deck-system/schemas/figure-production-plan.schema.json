{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figure-production-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "figure_id", "figure_type", "scientific_purpose", "evidence_status", "source_refs", "claim_refs", "hypothesis_layer_ref", "research_block_refs", "director_skill", "renderer", "ai_allowed", "source_requirement", "canonical_output_kind", "required_qa", "handoff_cursor"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "figure_id": {"type": "string", "pattern": "^FIG[0-9]{3,}$"},
    "figure_type": {"type": "string", "enum": ["vector_diagram", "scientific_plot", "real_photo", "literature_figure", "concept_illustration", "native_shape_figure"]},
    "scientific_purpose": {"type": "string", "minLength": 1, "maxLength": 160},
    "evidence_status": {"type": "string", "enum": ["empirical", "synthetic_test_evidence", "literature_evidence", "non_evidence"]},
    "source_refs": {"type": "array", "items": {"type": "string", "pattern": "^[EA][0-9]{3,}$"}, "uniqueItems": true},
    "claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3,}$"}, "uniqueItems": true},
    "hypothesis_layer_ref": {"type": "string", "pattern": "^H[0-9]{3,}$"},
    "research_block_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^B[0-9]{3,}$"}, "uniqueItems": true},
    "director_skill": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "renderer": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
    "ai_allowed": {"type": "boolean"},
    "source_requirement": {"type": "string", "enum": ["real_evidence", "literature_source", "canonical_data", "non_evidence_only", "structured_spec"]},
    "canonical_output_kind": {"type": "string", "enum": ["svg_vector", "pdf_vector", "source_evidence_asset", "extracted_source_figure", "generated_non_evidence_substrate", "native_shape_plan"]},
    "native_shape_eligibility": {"type": "object", "additionalProperties": false, "properties": {"evidence_ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"}}},
    "required_qa": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9_-]+$"}, "uniqueItems": true},
    "handoff_cursor": {"type": "integer", "minimum": 1}
  },
  "allOf": [{"if": {"properties": {"figure_type": {"const": "concept_illustration"}}, "required": ["figure_type"]}, "then": {"properties": {"evidence_status": {"const": "non_evidence"}, "ai_allowed": {"const": true}, "source_requirement": {"const": "non_evidence_only"}, "claim_refs": {"maxItems": 0}}}}]
}
