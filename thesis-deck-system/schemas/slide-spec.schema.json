{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slide-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slide_id", "revision", "deck_role", "block_refs", "stage", "native_layout_role", "recipe", "title", "placements", "citations", "speaker_notes", "story_visibility", "source_cursor", "bindings", "content"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "slide_id": {"type": "string", "pattern": "^S-B[0-9]{3,}-(OBSERVATION|RESULT|DISCUSSION)-[0-9]{2}$"},
    "revision": {"type": "integer", "minimum": 1},
    "deck_role": {"enum": ["research_block", "meeting_delta"]},
    "block_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block_ref"}},
    "stage": {"enum": ["observation", "result", "discussion"]},
    "native_layout_role": {"enum": ["photo_observation", "hero_plot_discussion"]},
    "recipe": {"enum": ["photo_observation", "hero_plot_discussion"]},
    "title": {"type": "object", "additionalProperties": false, "required": ["text", "assertion_claim_refs"], "properties": {"text": {"type": "string", "minLength": 1}, "assertion_claim_refs": {"$ref": "#/$defs/claim_refs"}}},
    "placements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["slot", "asset_id", "asset_path"], "properties": {"slot": {"const": "hero_visual"}, "asset_id": {"$ref": "#/$defs/asset_id"}, "asset_path": {"$ref": "#/$defs/repo_path"}}}},
    "citations": {"type": "array", "items": {"type": "string"}},
    "speaker_notes": {"type": "object", "additionalProperties": false, "required": ["source_refs", "text"], "properties": {"source_refs": {"$ref": "#/$defs/evidence_refs"}, "text": {"type": "string", "minLength": 1}}},
    "story_visibility": {"type": "object", "additionalProperties": false, "required": ["master", "meeting", "defense"], "properties": {"master": {"$ref": "#/$defs/visibility"}, "meeting": {"$ref": "#/$defs/visibility"}, "defense": {"$ref": "#/$defs/visibility"}}},
    "source_cursor": {"type": "integer", "minimum": 1},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["claim_refs", "evidence_refs", "asset_refs", "action_refs", "decision_refs", "professor_profile_ref", "template_profile_ref"], "properties": {"claim_refs": {"$ref": "#/$defs/claim_refs"}, "evidence_refs": {"$ref": "#/$defs/evidence_refs"}, "asset_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset_id"}}, "action_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^NS[0-9]{3,}$"}}, "decision_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^D[0-9]{3,}$"}}, "professor_profile_ref": {"$ref": "#/$defs/professor_ref"}, "template_profile_ref": {"$ref": "#/$defs/template_ref"}}},
    "content": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"recipe": {"const": "photo_observation"}}, "required": ["recipe"]}, "then": {"properties": {"content": {"$ref": "#/$defs/observation_content"}}}},
    {"if": {"properties": {"recipe": {"const": "hero_plot_discussion"}}, "required": ["recipe"]}, "then": {"properties": {"content": {"$ref": "#/$defs/result_content"}}}}
  ],
  "$defs": {
    "repo_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)(?!.*\\\\).+"},
    "visibility": {"enum": ["main", "appendix", "history", "hidden_from_default_view"]},
    "block_ref": {"type": "object", "additionalProperties": false, "required": ["block_id", "revision"], "properties": {"block_id": {"type": "string", "pattern": "^B[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1}}},
    "claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3,}$"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}, "uniqueItems": true},
    "asset_id": {"type": "string", "pattern": "^A[0-9]{3,}$"},
    "professor_ref": {"type": "object", "additionalProperties": false, "required": ["profile_id", "version"], "properties": {"profile_id": {"type": "string", "pattern": "^PROF-"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "template_ref": {"type": "object", "additionalProperties": false, "required": ["profile_id", "version"], "properties": {"profile_id": {"type": "string", "pattern": "^TP-"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "observation_content": {"type": "object", "additionalProperties": false, "required": ["observation", "problem", "observation_visual_path", "claim_refs", "evidence_refs"], "properties": {"observation": {"type": "string", "minLength": 1}, "problem": {"type": "string", "minLength": 1}, "observation_visual_path": {"$ref": "#/$defs/repo_path"}, "claim_refs": {"$ref": "#/$defs/claim_refs"}, "evidence_refs": {"$ref": "#/$defs/evidence_refs"}}},
    "result_content": {"type": "object", "additionalProperties": false, "required": ["discussion", "decision", "next_step", "claim_refs", "evidence_refs"], "properties": {"discussion": {"type": "string", "minLength": 1}, "decision": {"type": "string", "minLength": 1}, "next_step": {"type": "string", "minLength": 1}, "claim_refs": {"$ref": "#/$defs/claim_refs"}, "evidence_refs": {"$ref": "#/$defs/evidence_refs"}}}
  }
}
