{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "decision-event.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "decision_id", "block_ref", "timestamp", "actor", "decision_type", "subject_refs", "choice", "alternatives", "rationale", "evidence_refs", "provenance"],
  "properties": {"schema_version": {"const": "1.0.0"}, "decision_id": {"type": "string", "pattern": "^D[0-9]{3,}$"}, "block_ref": {"type": "object", "additionalProperties": false, "required": ["block_id", "revision"], "properties": {"block_id": {"type": "string", "pattern": "^B[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1}}}, "timestamp": {"type": "string", "format": "date-time"}, "actor": {"type": "object", "required": ["type", "id"], "properties": {"type": {"type": "string"}, "id": {"type": "string"}}}, "decision_type": {"type": "string", "enum": ["research_gate", "action_selection", "release", "profile_revision"]}, "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "choice": {"type": "string"}, "alternatives": {"type": "array", "items": {"type": ["string", "object"]}}, "rationale": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}}, "triggered_by": {"type": "array", "items": {"type": "string"}}, "supersedes": {"type": ["string", "null"]}, "provenance": {"type": "string"}}
}
