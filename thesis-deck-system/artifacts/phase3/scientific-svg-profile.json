{
  "schema_version": "1.0.0",
  "profile_id": "SSVG-P001",
  "svg_namespace": "http://www.w3.org/2000/svg",
  "root_contract": {"element": "svg", "required_attributes": ["viewBox", "data-thesis-svg-version", "data-thesis-figure-id"]},
  "allowed_elements": ["svg", "g", "defs", "rect", "circle", "ellipse", "line", "polyline", "polygon", "path", "text", "tspan", "image", "marker", "clipPath"],
  "semantic_attributes": ["data-thesis-svg-version", "data-thesis-figure-id", "data-visual-class", "data-semantic-role"],
  "id_policy": {"pattern": "^obj-[a-z][a-z0-9-]{0,63}$", "addressable_elements_require_id": true},
  "coordinate_policy": {"viewbox_required": true, "percent_geometry_allowed": false, "finite_numbers_only": true, "positive_dimension_attributes": ["width", "height", "r", "rx", "ry"]},
  "transform_policy": {"allowed_functions": ["translate", "scale", "rotate", "matrix"], "forbidden_functions": ["skewX", "skewY"]},
  "text_policy": {"utf8_required": true, "editable_elements": ["text", "tspan"], "unicode_normalization": "NFC", "synthetic_font_prefix": "synthetic-"},
  "resource_policy": {"allowed_reference_modes": ["bundle_relative", "synthetic_data_uri"], "forbidden_prefixes": ["http://", "https://", "file://", "//", "\\\\", "/mnt/"], "parent_traversal_forbidden": true},
  "style_policy": {"style_elements_allowed": false, "external_css_allowed": false, "presentation_attributes_only": true},
  "forbidden_features": ["script", "foreignObject", "animation", "event_handlers", "dtd", "external_entity", "filter", "html", "remote_resource"],
  "canonicalization": {"version": "1.0.0", "hash_algorithm": "sha256", "preserve_child_order": true, "sort_attributes": true, "numeric_format": "decimal_trimmed"},
  "finding_vocabulary": {"severities": ["critical", "error", "warning", "info"], "statuses": ["pass", "fail", "block"]}
}
