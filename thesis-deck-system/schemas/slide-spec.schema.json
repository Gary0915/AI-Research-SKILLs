{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "slide-spec.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "slide_id", "revision", "deck_role", "block_refs", "stage", "native_layout_role", "recipe", "title", "placements", "speaker_notes", "story_visibility", "source_cursor", "bindings"],
  "properties": {"schema_version": {"const": "1.0.0"}, "slide_id": {"pattern": "^S-"}, "revision": {"type": "integer", "minimum": 1}, "deck_role": {"enum": ["research_block", "meeting_delta"]}, "block_refs": {"type": "array", "minItems": 1}, "stage": {"enum": ["observation", "result", "discussion"]}, "native_layout_role": {"enum": ["photo_observation", "hero_plot_discussion"]}, "recipe": {"enum": ["photo_observation", "hero_plot_discussion"]}, "title": {"type": "object", "required": ["text", "assertion_claim_refs"]}, "placements": {"type": "array", "minItems": 1}, "citations": {"type": "array"}, "speaker_notes": {"type": "object", "required": ["source_refs", "text"]}, "story_visibility": {"type": "object"}, "source_cursor": {"type": "integer", "minimum": 1}, "bindings": {"type": "object", "required": ["claim_refs", "evidence_refs", "asset_refs", "action_refs", "professor_profile_ref", "template_profile_ref"]}}
}
