{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanitized-exemplar-manifest.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "exemplars"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^SEM[0-9]{3,}$"},
    "exemplars": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["alias_uri", "source_sha256", "profile_id", "authority"], "properties": {"alias_uri": {"type": "string", "enum": ["private://template_primary_1", "private://layout_exemplar_2", "private://template_primary_3"]}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "profile_id": {"type": "string", "pattern": "^P3-[A-Z0-9-]+$"}, "authority": {"type": "string", "enum": ["shell", "body_composition"]}}}}
  }
}
