{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scientific-svg-figure-output-manifest.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version","manifest_id","manifest_version","figure_id","figure_revision","figure_plan_ref","figure_plan_hash","figure_spec_ref","figure_spec_hash","canonical_output","svg_profile_ref","svg_profile_version","registry_ref","registry_version","used_feature_ids","capability_record_refs","fallback_decision","source_provenance_refs","style_resolution","privacy_state","output_lineage","static_critic","handoff_state"],
  "properties": {
    "schema_version":{"const":"1.0.0"}, "manifest_id":{"type":"string"}, "manifest_version":{"const":"1.0.0"},
    "figure_id":{"type":"string","pattern":"^FIG[0-9]{3}$"}, "figure_revision":{"type":"string"},
    "figure_plan_ref":{"type":"string","pattern":"^FPL[0-9]{3}$"}, "figure_plan_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "figure_spec_ref":{"type":"string","pattern":"^FIG[0-9]{3}$"}, "figure_spec_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "canonical_output":{"type":"object","additionalProperties":false,"required":["kind","canonical_sha256","source_sha256","canonical_svg"],"properties":{"kind":{"const":"scientific_svg"},"canonical_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"canonical_svg":{"type":"string"}}},
    "svg_profile_ref":{"const":"SSVG-P001"}, "svg_profile_version":{"const":"1.0.0"}, "registry_ref":{"const":"SNCR001"}, "registry_version":{"const":"1.0.0"},
    "used_feature_ids":{"type":"array","minItems":1,"items":{"type":"string"}}, "capability_record_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "fallback_decision":{"enum":["none","explicit_vector_fallback","explicit_raster_fallback"]},
    "source_provenance_refs":{"type":"object","additionalProperties":false,"required":["source_refs","claim_refs","evidence_refs"],"properties":{"source_refs":{"type":"array","items":{"type":"string"}},"claim_refs":{"type":"array","items":{"type":"string"}},"evidence_refs":{"type":"array","items":{"type":"string"}}}},
    "style_resolution":{"type":"object","additionalProperties":false,"required":["style_profile_ref","required_categories","token_provenance","application_trace","material_semantic_colors_not_consumed"],"properties":{"style_profile_ref":{"type":"string","pattern":"^VSP[0-9]{3}$"},"required_categories":{"type":"array","items":{"enum":["shell_geometry","typography_hierarchy","body_composition","scientific_figure_metrics","connector_arrow_grammar","line_style_grammar","color_emphasis_grammar"]},"uniqueItems":true},"token_provenance":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["token_id","authority_family","token_family","origin","evidence_tier","resolver_rule_id","source_role","source_scope"],"properties":{"token_id":{"type":"string"},"authority_family":{"type":"string"},"token_family":{"type":"string"},"origin":{"enum":["professor_derived","phase2_fallback","implementation_fallback","unresolved"]},"evidence_tier":{"enum":["recurring_pattern","single_example_provisional","indirect_supported","insufficient_evidence"]},"resolver_rule_id":{"type":"string"},"source_role":{"type":"string"},"source_scope":{"type":"string"}}}},"application_trace":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["category","attribute","source","token_id"],"properties":{"category":{"enum":["shell_geometry","typography_hierarchy","body_composition","scientific_figure_metrics","connector_arrow_grammar","line_style_grammar","color_emphasis_grammar"]},"attribute":{"type":"string"},"source":{"enum":["vsp003","implementation_fallback"]},"token_id":{"type":["string","null"]}}}},"material_semantic_colors_not_consumed":{"const":true}}},
    "privacy_state":{"type":"object","additionalProperties":false,"required":["private_alias_resolution_attempts","private_source_open_attempts","private_render_attempts"],"properties":{"private_alias_resolution_attempts":{"const":0},"private_source_open_attempts":{"const":0},"private_render_attempts":{"const":0}}},
    "output_lineage":{"type":"object","additionalProperties":false,"required":["parent_kind","raw_to_layout_forbidden"],"properties":{"parent_kind":{"const":"ScientificFigureSpec"},"raw_to_layout_forbidden":{"const":true}}},
    "static_critic":{"type":"object","additionalProperties":false,"required":["executed","status"],"properties":{"executed":{"type":"boolean"},"status":{"enum":["not_run","APPROVED_FIGURE","FAIL","BLOCKED"]}}},
    "handoff_state":{"enum":["raw_output_not_layout_eligible","approved_figure_layout_eligible"]}
  }
}
