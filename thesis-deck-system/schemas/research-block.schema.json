{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-block.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "block_id", "revision", "title", "research_question", "problem_statement", "research_status", "story_visibility", "hypothesis_claim_refs", "mechanism_claim_refs", "prediction_claim_refs", "stage_refs", "claim_refs", "evidence_refs", "asset_refs", "action_item_refs", "decision_refs", "decision_criteria_ref", "provenance", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "block_id": {"pattern": "^B[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1}, "title": {"type": "string", "minLength": 1},
    "research_question": {"type": "object", "additionalProperties": false, "required": ["question_id", "text", "scope"], "properties": {"question_id": {"pattern": "^RQ-"}, "text": {"type": "string", "minLength": 10}, "scope": {"type": "string", "minLength": 1}}},
    "problem_statement": {"type": "string", "minLength": 10}, "research_status": {"enum": ["active", "resolved", "failed_but_informative", "superseded"]},
    "story_visibility": {"type": "object", "required": ["master", "meeting", "defense"], "additionalProperties": false, "properties": {"master": {"$ref": "#/$defs/visibility"}, "meeting": {"$ref": "#/$defs/visibility"}, "defense": {"$ref": "#/$defs/visibility"}}},
    "hypothesis_claim_refs": {"$ref": "#/$defs/nonemptyClaims"}, "mechanism_claim_refs": {"$ref": "#/$defs/nonemptyClaims"}, "prediction_claim_refs": {"$ref": "#/$defs/nonemptyClaims"},
    "stage_refs": {"type": "object", "additionalProperties": false, "required": ["observation", "literature", "mechanism", "solution", "experiment", "result", "discussion", "next_step"], "properties": {"observation": {"type": "string", "minLength": 1}, "literature": {"type": "string", "minLength": 1}, "mechanism": {"type": "string", "minLength": 1}, "solution": {"type": "string", "minLength": 1}, "experiment": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}, "discussion": {"type": "string", "minLength": 1}, "next_step": {"pattern": "^NS[0-9]{3,}$"}}},
    "claim_refs": {"type": "array", "items": {"pattern": "^C[0-9]{3,}$"}}, "evidence_refs": {"type": "array", "items": {"pattern": "^E[0-9]{3,}$"}}, "asset_refs": {"type": "array", "items": {"pattern": "^A[0-9]{3,}$"}}, "action_item_refs": {"type": "array", "items": {"pattern": "^NS[0-9]{3,}$"}}, "decision_refs": {"type": "array", "items": {"pattern": "^D[0-9]{3,}$"}},
    "decision_criteria_ref": {"type": "string", "minLength": 1}, "provenance": {"type": "string", "minLength": 1}, "created_at": {"format": "date-time"}, "updated_at": {"format": "date-time"}
  },
  "$defs": {"visibility": {"enum": ["main", "appendix", "history", "hidden_from_default_view"]}, "nonemptyClaims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^C[0-9]{3,}$"}}}
}
