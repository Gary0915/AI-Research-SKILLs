{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "slide-spec.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "slide_id", "revision", "deck_role", "block_refs", "stage", "native_layout_role", "recipe", "title", "placements", "speaker_notes", "story_visibility", "source_cursor", "bindings"],
  "properties": {"schema_version": {"const": "1.0.0"}, "slide_id": {"type":"string","pattern": "^S-"}, "revision": {"type": "integer", "minimum": 1}, "deck_role": {"enum": ["research_block", "meeting_delta"]}, "block_refs": {"type": "array", "minItems": 1, "items":{"type":"object","required":["block_id","revision"],"properties":{"block_id":{"type":"string","pattern":"^B[0-9]{3,}$"},"revision":{"type":"integer","minimum":1}},"additionalProperties":false}}, "stage": {"enum": ["observation", "result", "discussion"]}, "native_layout_role": {"enum": ["photo_observation", "hero_plot_discussion"]}, "recipe": {"enum": ["photo_observation", "hero_plot_discussion"]}, "title": {"type": "object", "required": ["text", "assertion_claim_refs"],"properties":{"text":{"type":"string"},"assertion_claim_refs":{"type":"array","items":{"type":"string","pattern":"^C"}}},"additionalProperties":false}, "placements": {"type": "array", "minItems": 1,"items":{"type":"object","required":["slot","asset_id"],"properties":{"slot":{"type":"string"},"asset_id":{"type":"string","pattern":"^A"},"asset_path":{"type":"string","pattern":"^(?!/)(?![A-Za-z]:)(?!\\\\)"}},"additionalProperties":false}}, "citations": {"type": "array"}, "speaker_notes": {"type": "object", "required": ["source_refs", "text"]}, "story_visibility": {"type": "object"}, "source_cursor": {"type": "integer", "minimum": 1}, "bindings": {"type": "object", "required": ["claim_refs", "evidence_refs", "asset_refs", "action_refs", "professor_profile_ref", "template_profile_ref"]}, "content":{"type":"object"}}
}
