{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-routing.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": {"enum": ["3.0.0", "4.0.0"]},
    "registry_id": {"type": "string", "pattern": "^CP4-SKILL-REGISTRY-[0-9]{3,}$"},
    "skills": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/skill"}},
    "routes": {"oneOf": [
      {"type": "array", "items": {"$ref": "#/$defs/legacy_route"}},
      {"type": "object", "additionalProperties": {"$ref": "#/$defs/user_route"}}
    ]},
    "handoff_graph": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]+$"}}
  },
  "$defs": {
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["skill_id", "trigger", "output_contract", "qa_owner"],
      "properties": {
        "skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "trigger": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]+$"},
        "do_not_trigger": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "inputs": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]+$"}},
        "required_context": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "workflow": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "allowed_downstream": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]+$"}},
        "forbidden_actions": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "forbidden_responsibilities": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "output_contract": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]+$"},
        "provenance_behavior": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "failure_modes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "blocked_states": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "handoff_target": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]+$"},
        "handoff": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]+$"},
        "qa_owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}
      }
    },
    "user_route": {
      "type": "object", "additionalProperties": false,
      "required": ["top_level", "handoff"],
      "properties": {"top_level": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "handoff": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}}}
    },
    "legacy_route": {
      "type": "object", "additionalProperties": false,
      "required": ["request_kind", "skill_id", "next_skill_id"],
      "properties": {"request_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}, "skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "next_skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}}
    }
  },
  "allOf": [{"oneOf": [
    {"properties": {"schema_version": {"const": "3.0.0"}}, "required": ["schema_version", "skills", "routes"]},
    {"properties": {"schema_version": {"const": "4.0.0"}}, "required": ["schema_version", "registry_id", "skills", "handoff_graph"]}
  ]}]
}
