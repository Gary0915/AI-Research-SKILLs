{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "deck-manifest.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "deck_id", "deck_kind", "title", "template_profile_ref", "professor_profile_ref", "source_event_cursor", "build_id", "build_tool_version", "created_at", "projection", "slides", "outputs", "qa_report_refs"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "deck_id": {"type": "string", "pattern": "^MASTER-PHASE1-"}, "deck_kind": {"enum": ["master", "meeting", "defense"]}, "title": {"type": "string", "minLength": 1},
    "template_profile_ref": {"$ref": "#/$defs/template_ref"}, "professor_profile_ref": {"$ref": "#/$defs/professor_ref"}, "source_event_cursor": {"type": "integer", "minimum": 1},
    "build_id": {"type": "string", "pattern": "^BUILD-"}, "build_tool_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "created_at": {"type": "string", "format": "date-time"},
    "projection": {"type": "object", "additionalProperties": false, "required": ["query"], "properties": {"query": {"type": "string", "minLength": 1}}},
    "slides": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/slide"}},
    "outputs": {"type": "object", "additionalProperties": false, "required": ["pptx", "pptx_sha256"], "properties": {"pptx": {"$ref": "#/$defs/repo_path"}, "pptx_sha256": {"$ref": "#/$defs/sha"}}},
    "qa_report_refs": {"type": "array", "items": {"type": "string", "pattern": "^QA-"}}
  },
  "$defs": {
    "repo_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)(?!.*\\\\).+"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "template_ref": {"type": "object", "additionalProperties": false, "required": ["profile_id", "version"], "properties": {"profile_id": {"type": "string", "pattern": "^TP-"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "professor_ref": {"type": "object", "additionalProperties": false, "required": ["profile_id", "version"], "properties": {"profile_id": {"type": "string", "pattern": "^PROF-"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "block_ref": {"type": "object", "additionalProperties": false, "required": ["block_id", "revision"], "properties": {"block_id": {"type": "string", "pattern": "^B[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1}}},
    "slide": {"type": "object", "additionalProperties": false, "required": ["ordinal", "slide_id", "slide_spec_path", "slide_spec_sha256", "block_ref", "claim_refs", "evidence_refs", "asset_refs", "action_refs", "professor_profile_ref", "template_profile_ref", "source_event_cursor", "story_visibility"], "properties": {
      "ordinal": {"type": "integer", "minimum": 1}, "slide_id": {"type": "string", "pattern": "^S-"}, "slide_spec_path": {"$ref": "#/$defs/repo_path"}, "slide_spec_sha256": {"$ref": "#/$defs/sha"}, "block_ref": {"$ref": "#/$defs/block_ref"},
      "claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3,}$"}, "uniqueItems": true}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}, "uniqueItems": true}, "asset_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^A[0-9]{3,}$"}}, "action_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^NS[0-9]{3,}$"}},
      "professor_profile_ref": {"$ref": "#/$defs/professor_ref"}, "template_profile_ref": {"$ref": "#/$defs/template_ref"}, "source_event_cursor": {"type": "integer", "minimum": 1}, "story_visibility": {"enum": ["main", "appendix", "history", "hidden_from_default_view"]}
    }}
  }
}
