{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "asset-manifest.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "asset_id", "asset_type", "title", "evidence_role", "source_evidence", "path", "preview_path", "mime_type", "sha256", "editable", "provenance", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "asset_id": {"type": "string", "pattern": "^A[0-9]{3,}$"}, "asset_type": {"enum": ["data_plot", "observation_photo", "mechanism_diagram", "experimental_setup", "literature_figure", "microscopy_image", "generated_context"]}, "title": {"type": "string", "minLength": 1},
    "evidence_role": {"enum": ["quantitative_evidence", "synthetic_test_evidence", "literature_evidence", "context", "decorative_only"]}, "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}, "uniqueItems": true},
    "path": {"$ref": "#/$defs/repo_path"}, "preview_path": {"$ref": "#/$defs/repo_path"}, "mime_type": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "editable": {"type": "boolean"},
    "generator": {"$ref": "#/$defs/generator"}, "input": {"$ref": "#/$defs/input"}, "output": {"$ref": "#/$defs/output"}, "transform_chain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transform"}},
    "provenance": {"type": "string", "minLength": 1}, "license_or_usage": {"type": "string"}, "accessibility": {"type": "object", "additionalProperties": false, "required": ["alt_text"], "properties": {"alt_text": {"type": "string", "minLength": 1}}}, "status": {"enum": ["draft", "approved", "rejected"]}
  },
  "allOf": [
    {"if": {"properties": {"asset_type": {"const": "data_plot"}}, "required": ["asset_type"]}, "then": {"required": ["generator", "input", "output", "transform_chain", "accessibility"]}},
    {"if": {"properties": {"asset_type": {"const": "generated_context"}}, "required": ["asset_type"]}, "then": {"properties": {"evidence_role": {"const": "decorative_only"}}}}
  ],
  "$defs": {
    "repo_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)(?!.*\\\\).+"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator": {"type": "object", "additionalProperties": false, "required": ["kind", "version", "script", "script_sha256"], "properties": {"kind": {"const": "matplotlib"}, "version": {"type": "string", "minLength": 1}, "script": {"$ref": "#/$defs/repo_path"}, "script_sha256": {"$ref": "#/$defs/sha"}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/repo_path"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["svg_path", "svg_sha256", "png_path", "png_sha256"], "properties": {"svg_path": {"$ref": "#/$defs/repo_path"}, "svg_sha256": {"$ref": "#/$defs/sha"}, "png_path": {"$ref": "#/$defs/repo_path"}, "png_sha256": {"$ref": "#/$defs/sha"}}},
    "transform": {"type": "object", "additionalProperties": false, "required": ["input_sha256", "operation", "output_sha256"], "properties": {"input_sha256": {"$ref": "#/$defs/sha"}, "operation": {"type": "string", "minLength": 1}, "output_sha256": {"$ref": "#/$defs/sha"}}}
  }
}
