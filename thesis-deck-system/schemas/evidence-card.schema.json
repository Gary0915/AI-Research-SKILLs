{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "evidence-card.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "kind", "title", "provenance", "source", "claim_support_refs", "claim_contradict_refs", "scope", "verification"],
  "properties": {"schema_version": {"const": "1.0.0"}, "evidence_id": {"type": "string", "pattern": "^E[0-9]{3,}$"}, "kind": {"enum": ["experimental_measurement", "synthetic_measurement", "literature_claim", "synthetic_literature", "literature_figure", "observation_photo", "synthetic_observation", "microscopy_image", "simulation_output", "generated_context"]}, "title": {"type": "string", "minLength": 1}, "provenance": {"type": "string"}, "source": {"type": "object", "required": ["source_id", "uri", "sha256"], "properties": {"source_id": {"type": "string"}, "uri": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "locator": {"type": "object"}}}, "claim_support_refs": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3,}$"}}, "claim_contradict_refs": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3,}$"}}, "scope": {"type": "object"}, "measurement": {"type": "object"}, "causal_role": {"type": "string", "enum": ["supporting_observation", "transition_precursor", "experiment_input", "experiment_result", "derived_result", "literature"]}, "origin": {"type": "object", "additionalProperties": false, "properties": {"layer_ref": {"type": "string", "pattern": "^H[0-9]{3}$"}, "stage_ref": {"type": "string", "pattern": "^ST-[A-Z0-9-]+$"}, "experiment_stage_ref": {"type": "string", "pattern": "^ST-EXP[0-9]{3,}$"}, "source_dataset_role": {"type": "string", "enum": ["preexisting_observation", "pre_h02_uncertainty", "experiment_input", "discriminating_result", "derived_result"]}}}, "license_or_usage": {"type": "string"}, "verification": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["verified", "synthetic_test_only", "unverified"]}}}},
  "allOf": [{"if": {"properties": {"kind": {"const": "generated_context"}}, "required": ["kind"]}, "then": {"properties": {"claim_support_refs": {"maxItems": 0}, "claim_contradict_refs": {"maxItems": 0}}}}]
}
