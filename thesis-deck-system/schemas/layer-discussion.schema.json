{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "layer-discussion.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "discussion_id", "hypothesis_layer_ref", "supporting_results", "contradicting_results", "non_discriminating_results", "cross_experiment_pattern", "mechanism_assessment", "alternative_explanations", "remaining_uncertainty", "hypothesis_status", "decision_ref", "next_step_refs", "source_event_cursor", "created_at"],
  "properties": {"schema_version": {"const": "2.0.0"}, "discussion_id": {"type": "string", "pattern": "^DISC-H[0-9]{3}$"}, "hypothesis_layer_ref": {"type": "string", "pattern": "^H[0-9]{3}$"}, "supporting_results": {"$ref": "#/$defs/result_refs"}, "contradicting_results": {"$ref": "#/$defs/result_refs"}, "non_discriminating_results": {"$ref": "#/$defs/result_refs"}, "cross_experiment_pattern": {"type": "string", "minLength": 1}, "mechanism_assessment": {"type": "string", "minLength": 1}, "alternative_explanations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "remaining_uncertainty": {"type": "string", "minLength": 1}, "hypothesis_status": {"type": "string", "enum": ["supported", "partial_support", "rejected", "inconclusive"]}, "decision_ref": {"type": "string", "pattern": "^D[0-9]{3,}$"}, "next_step_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^NS[0-9]{3,}$"}}, "source_event_cursor": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}},
  "$defs": {"result_refs": {"type": "array", "items": {"type": "string", "pattern": "^RES[0-9]{3,}$"}, "uniqueItems": true}}
}
