{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "body-composition-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "families",
    "candidate_slide_bindings",
    "audit_only_metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "profile_id": {
      "const": "P3-BODY-GRAMMAR-001"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "audit_only_metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audit"
      }
    },
    "candidate_slide_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "tier": {
      "enum": [
        "recurring_pattern",
        "single_example_provisional",
        "indirect_supported",
        "insufficient_evidence"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "availability",
        "observed_range",
        "robust_center",
        "sample_count",
        "preferred_descriptor_id",
        "outlier_descriptor_ids"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "observed_range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "robust_center": {
          "type": [
            "number",
            "null"
          ]
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "preferred_descriptor_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        },
        "outlier_descriptor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "representative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "comparable_metric_count",
        "missing_data_penalty",
        "outlier_method_id"
      ],
      "properties": {
        "method_id": {
          "const": "CP3-NORMALIZED-PAIRWISE-MEDOID-V1"
        },
        "comparable_metric_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_data_penalty": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "outlier_method_id": {
          "const": "CP3-MAD-OUTLIER-V1"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "family",
        "source_role",
        "source_profile_id",
        "supporting_descriptor_ids",
        "sample_count",
        "source_confidence",
        "evidence_tier",
        "metric_distributions",
        "preferred_descriptor_id",
        "outlier_descriptor_ids",
        "unavailable_metrics",
        "representative_method",
        "status"
      ],
      "properties": {
        "family_id": {
          "$ref": "#/$defs/id"
        },
        "family": {
          "enum": [
            "result_single",
            "image_matrix",
            "photo_schematic",
            "control_proposed_comparison",
            "experiment_schematic",
            "result_comparison",
            "result_discussion",
            "fishbone_research_map",
            "fabrication_process_flow",
            "other_insufficient_structural_evidence"
          ]
        },
        "source_role": {
          "const": "P3-LAYOUT-EXEMPLAR-2"
        },
        "source_profile_id": {
          "const": "P3-LAYOUT-EXEMPLAR-2"
        },
        "supporting_descriptor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_confidence": {
          "enum": [
            "structurally_supported",
            "provisional",
            "insufficient_structural_evidence"
          ]
        },
        "evidence_tier": {
          "$ref": "#/$defs/tier"
        },
        "metric_distributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "preferred_descriptor_id": {
          "$ref": "#/$defs/id"
        },
        "outlier_descriptor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "unavailable_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          }
        },
        "representative_method": {
          "$ref": "#/$defs/representative"
        },
        "status": {
          "enum": [
            "resolved",
            "provisional",
            "insufficient"
          ]
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "sample_count",
        "observed_range",
        "status"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "status": {
          "const": "audit_only"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "candidate_id",
        "slide_id",
        "family",
        "confidence",
        "binding_method_id",
        "binding_evidence",
        "binding_status"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/id"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^BC[0-9]{3,}$"
        },
        "slide_id": {
          "type": "string",
          "pattern": "^SL[0-9]{3,}$"
        },
        "family": {
          "enum": [
            "result_single",
            "image_matrix",
            "photo_schematic",
            "control_proposed_comparison",
            "experiment_schematic",
            "result_comparison",
            "result_discussion",
            "fishbone_research_map",
            "fabrication_process_flow",
            "other_insufficient_structural_evidence"
          ]
        },
        "confidence": {
          "enum": [
            "structurally_supported",
            "provisional",
            "insufficient_structural_evidence"
          ]
        },
        "binding_method_id": {
          "const": "CP3-EXPLICIT-CP2-CANDIDATE-SLIDE-BINDING-V1"
        },
        "binding_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding_fingerprint",
            "candidate_evidence_ids"
          ],
          "properties": {
            "binding_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "candidate_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+$"
              }
            }
          }
        },
        "binding_status": {
          "const": "resolved"
        }
      }
    }
  }
}
