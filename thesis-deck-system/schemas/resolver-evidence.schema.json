  },
  "$defs": {
    "fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "kind",
            "boolean"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]+$"
            },
            "kind": {
              "const": "boolean"
            },
            "boolean": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "kind",
            "integer"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]+$"
            },
            "kind": {
              "const": "integer"
            },
            "integer": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "kind",
            "identifier"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]+$"
            },
            "kind": {
              "const": "controlled_id"
            },
            "identifier": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "kind",
            "identifiers"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]+$"
            },
            "kind": {
              "const": "identifier_list"
            },
            "identifiers": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^CP3-[A-Z0-9-]+$"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "facts"
          ],
          "properties": {
            "facts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/fact"
              }
            }
          }
        }
      }
    }
  }
}
