{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "professor-template-resolved.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "status", "safe_content_bounds", "content_master_layout_topology", "shell_tokens", "conflicts"],
  "properties": {"schema_version": {"const": "2.0.0"}, "profile_id": {"const": "P3-RESOLVED-SHELL-001"}, "status": {"enum": ["pass", "fail"]}, "safe_content_bounds": {"$ref": "#/$defs/safeBounds"}, "content_master_layout_topology": {"type": "array", "items": {"$ref": "#/$defs/topology"}}, "shell_tokens": {"type": "array", "items": {"$ref": "#/$defs/shellToken"}}, "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}},
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"}, "tier": {"enum": ["recurring_pattern", "single_example_provisional", "indirect_supported", "insufficient_evidence"]},
    "geometry": {"type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "w": {"type": "number", "minimum": 0, "maximum": 1}, "h": {"type": "number", "minimum": 0, "maximum": 1}}},
    "value": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "unavailable"}, "value": {"type": "null"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "geometry"], "properties": {"kind": {"const": "geometry"}, "geometry": {"$ref": "#/$defs/geometry"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "width", "height"], "properties": {"kind": {"const": "canvas"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "number"], "properties": {"kind": {"const": "number"}, "number": {"type": "number"}}}]},
    "scopeSupport": {"type": "object", "additionalProperties": false, "required": ["source_scope", "occurrence_count", "source_container_count", "eligible_container_count", "coverage_ratio", "supporting_source_ids"], "properties": {"source_scope": {"enum": ["slide_master", "slide_layout", "slide_recurrence_derived"]}, "occurrence_count": {"type": "integer", "minimum": 0}, "source_container_count": {"type": "integer", "minimum": 0}, "eligible_container_count": {"type": "integer", "minimum": 0}, "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "supporting_source_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "variant": {"type": "object", "additionalProperties": false, "required": ["region_id", "value", "supporting_ids"], "properties": {"region_id": {"$ref": "#/$defs/id"}, "value": {"$ref": "#/$defs/value"}, "supporting_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "shellToken": {"type": "object", "additionalProperties": false, "required": ["token_id", "token_family", "value", "profile_id", "source_role", "supporting_ids", "support_count", "support_by_scope", "variants", "evidence_tier", "resolver_rule_id", "authority_family", "origin"], "properties": {"token_id": {"$ref": "#/$defs/id"}, "token_family": {"enum": ["canvas", "content_title", "hypothesis_history", "cover_divider_title", "footer", "page_number", "navigation"]}, "value": {"$ref": "#/$defs/value"}, "profile_id": {"enum": ["P3-TEMPLATE-PRIMARY-1", "P3-TEMPLATE-PRIMARY-3"]}, "source_role": {"enum": ["P3-TEMPLATE-PRIMARY-1", "P3-TEMPLATE-PRIMARY-3"]}, "supporting_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "support_count": {"type": "integer", "minimum": 0}, "support_by_scope": {"type": "array", "items": {"$ref": "#/$defs/scopeSupport"}}, "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}}, "evidence_tier": {"$ref": "#/$defs/tier"}, "resolver_rule_id": {"$ref": "#/$defs/id"}, "authority_family": {"const": "formal_shell"}, "origin": {"enum": ["professor_derived", "unresolved"]}}},
    "topology": {"type": "object", "additionalProperties": false, "required": ["source_id", "target_id", "basis", "source_scope"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "target_id": {"$ref": "#/$defs/id"}, "basis": {"enum": ["measured", "derived"]}, "source_scope": {"const": "slide_layout"}}},
    "safeBounds": {"type": "object", "additionalProperties": false, "required": ["status", "value", "supporting_ids", "resolver_rule_id"], "properties": {"status": {"enum": ["resolved", "insufficient_evidence"]}, "value": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/geometry"}]}, "supporting_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "resolver_rule_id": {"$ref": "#/$defs/id"}}},
    "losingEvidence": {"type": "object", "additionalProperties": false, "required": ["profile_id", "supporting_ids", "value"], "properties": {"profile_id": {"enum": ["P3-TEMPLATE-PRIMARY-1", "P3-TEMPLATE-PRIMARY-3"]}, "supporting_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "value": {"$ref": "#/$defs/value"}}},
    "conflict": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "token_family", "selected_value", "winning_profile_id", "winning_source_role", "losing_alternatives", "losing_profile_ids", "losing_descriptor_evidence", "conflict_rule_id", "conflict_classification", "evidence_tier", "status"], "properties": {"conflict_id": {"$ref": "#/$defs/id"}, "token_family": {"type": "string", "pattern": "^[a-z_]+$"}, "selected_value": {"$ref": "#/$defs/value"}, "winning_profile_id": {"enum": ["P3-TEMPLATE-PRIMARY-1", "P3-TEMPLATE-PRIMARY-3"]}, "winning_source_role": {"enum": ["P3-TEMPLATE-PRIMARY-1", "P3-TEMPLATE-PRIMARY-3"]}, "losing_alternatives": {"type": "array", "items": {"$ref": "#/$defs/value"}, "minItems": 1}, "losing_profile_ids": {"type": "array", "items": {"enum": ["P3-TEMPLATE-PRIMARY-1", "P3-TEMPLATE-PRIMARY-3"]}, "minItems": 1}, "losing_descriptor_evidence": {"type": "array", "items": {"$ref": "#/$defs/losingEvidence"}, "minItems": 1}, "conflict_rule_id": {"$ref": "#/$defs/id"}, "conflict_classification": {"enum": ["soft_resolved", "hard_blocking"]}, "evidence_tier": {"$ref": "#/$defs/tier"}, "status": {"enum": ["pass", "fail"]}}}
  }
}
