{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "template-profile.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "source_path", "source_sha256", "slide_size", "masters", "layouts", "theme", "semantic_roles", "created_at"],
  "properties": {"schema_version": {"const": "1.0.0"}, "profile_id": {"pattern": "^TP-"}, "version": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "source_path": {"type": "string"}, "source_sha256": {"pattern": "^[0-9a-f]{64}$"}, "slide_size": {"type": "object", "required": ["width_emu", "height_emu", "aspect_ratio"]}, "masters": {"type": "array", "minItems": 1}, "layouts": {"type": "array", "minItems": 2}, "theme": {"type": "object", "required": ["major_fonts", "minor_fonts", "colors"]}, "semantic_roles": {"type": "object", "required": ["photo_observation", "hero_plot_discussion"]}, "created_at": {"format": "date-time"}}
}
