{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "fishbone-map.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "fishbone_id", "title", "thesis_problem", "latest_revision", "revision_refs", "created_at", "updated_at"],
  "properties": {"schema_version": {"const": "2.0.0"}, "fishbone_id": {"type": "string", "pattern": "^FB[0-9]{3}$"}, "title": {"type": "string", "minLength": 1}, "thesis_problem": {"type": "string", "minLength": 1}, "latest_revision": {"type": "integer", "minimum": 1}, "revision_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}
}
