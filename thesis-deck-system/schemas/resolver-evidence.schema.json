                "provisional_only",
                "unresolved"
              ]
            },
            "unresolved_fallback_reference": {
              "enum": [
                "fully_calibrated",
                "partial_recurring",
                "provisional_only",
                "unresolved"
              ]
            }
          }
        },
        "category_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shell_geometry",
            "typography_hierarchy",
            "body_composition",
            "scientific_figure_metrics",
            "connector_arrow_grammar",
            "line_style_grammar",
            "color_emphasis_grammar",
            "unresolved_fallback_reference"
          ],
          "properties": {
            "shell_geometry": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "professor_derived_recurring",
                "professor_derived_provisional",
                "fallback",
                "unresolved",
                "reference_only_metadata"
              ],
