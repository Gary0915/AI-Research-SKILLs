{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "next-step.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "action_item_id", "revision", "action_type", "title", "action", "rationale", "source_decision_ref", "linked_block_refs", "linked_claim_refs", "prior_commitment", "owner", "target_window", "actual_completion", "success_failure_criteria", "required_evidence", "dependency_refs", "blocker_refs", "parallelizable", "workstream", "status", "provenance", "created_at", "updated_at"],
  "properties": {"schema_version": {"const": "1.0.0"}, "action_item_id": {"pattern": "^NS[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1}, "action_type": {"enum": ["experiment", "analysis", "literature", "fabrication", "decision"]}, "title": {"type": "string"}, "action": {"type": "string", "minLength": 3}, "rationale": {"type": "string", "minLength": 3}, "source_decision_ref": {"pattern": "^D[0-9]{3,}$"}, "linked_block_refs": {"type": "array", "minItems": 1}, "linked_claim_refs": {"type": "array", "items": {"pattern": "^C[0-9]{3,}$"}}, "prior_commitment": {"type": "object", "required": ["meeting_id", "committed_at"]}, "owner": {"type": "object", "required": ["actor_id", "display_name"]}, "target_window": {"type": "object", "required": ["start", "due", "timezone"]}, "actual_completion": {"type": "object", "required": ["completed_at", "closure_evidence_refs"]}, "success_failure_criteria": {"type": "object", "required": ["success", "failure"]}, "required_evidence": {"type": "array"}, "dependency_refs": {"type": "array"}, "blocker_refs": {"type": "array"}, "parallelizable": {"type": "boolean"}, "workstream": {"type": "string"}, "status": {"enum": ["planned", "in_progress", "blocked", "done", "cancelled", "superseded"]}, "result_summary": {"type": ["string", "null"]}, "supersedes": {"type": "array"}, "superseded_by": {"type": "array"}, "provenance": {"type": "string"}, "created_at": {"format": "date-time"}, "updated_at": {"format": "date-time"}}
}
