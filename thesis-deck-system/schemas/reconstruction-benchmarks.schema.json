{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"reconstruction-benchmarks.schema.json","type":"object","additionalProperties":false,"required":["schema_version","benchmarks"],"properties":{"schema_version":{"const":"1.0.0"},"benchmarks":{"type":"array","minItems":8,"items":{"$ref":"#/$defs/benchmark"}}},"$defs":{"fixture":{"type":"object","additionalProperties":false,"required":["fixture_id","input_kind","expected_invariants"],"properties":{"fixture_id":{"type":"string","pattern":"^G1-[a-z_]+-(REP|STRESS)$"},"input_kind":{"const":"synthetic_structural_fixture"},"expected_invariants":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[a-z0-9_]+$"}}}},"evaluation":{"type":"object","additionalProperties":false,"required":["status","safe_bounds_result","render_result"],"properties":{"status":{"const":"provisional"},"safe_bounds_result":{"enum":["pass","fail","insufficient_evidence"]},"render_result":{"enum":["not_measured","pass","fail"]}}},"benchmark":{"type":"object","additionalProperties":false,"required":["family","representative_fixture","stress_fixture","evaluation_result"],"properties":{"family":{"type":"string"},"representative_fixture":{"$ref":"#/$defs/fixture"},"stress_fixture":{"$ref":"#/$defs/fixture"},"evaluation_result":{"$ref":"#/$defs/evaluation"}}}}}
