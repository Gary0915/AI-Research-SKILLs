{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "template-profile.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "source_path", "source_sha256", "slide_size", "masters", "layouts", "theme", "semantic_roles", "created_at"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0", "2.0.0"]}, "profile_id": {"type": "string", "pattern": "^TP-"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "source_path": {"$ref": "#/$defs/repo_path"}, "source_sha256": {"$ref": "#/$defs/sha"},
    "slide_size": {"type": "object", "additionalProperties": false, "required": ["width_emu", "height_emu", "aspect_ratio"], "properties": {"width_emu": {"type": "integer", "minimum": 1}, "height_emu": {"type": "integer", "minimum": 1}, "aspect_ratio": {"const": "16:9"}}},
    "masters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/master"}}, "layouts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/layout"}},
    "theme": {"type": "object", "additionalProperties": false, "required": ["major_fonts", "minor_fonts", "colors"], "properties": {"major_fonts": {"type": "array", "items": {"type": "string"}}, "minor_fonts": {"type": "array", "items": {"type": "string"}}, "colors": {"type": "array", "items": {"type": "string"}}}},
    "semantic_roles": {"type": "object", "additionalProperties": false, "required": ["photo_observation", "hero_plot_discussion"], "properties": {"photo_observation": {"$ref": "#/$defs/role"}, "hero_plot_discussion": {"$ref": "#/$defs/role"}, "content_academic": {"$ref": "#/$defs/role"}}},
    "created_at": {"type": "string", "format": "date-time"}, "safe_content_bounds": {"$ref": "#/$defs/emu_geometry"}, "title_zone": {"$ref": "#/$defs/emu_geometry"}, "recurring_objects": {"type": "object", "additionalProperties": false, "properties": {"footer": {"type": "string"}, "slide_number": {"type": "string"}, "logo": {"type": ["string", "null"]}}}, "fixed_navigation_zones": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "top_emu", "height_emu"], "properties": {"name": {"type": "string"}, "top_emu": {"type": "integer", "minimum": 0}, "height_emu": {"type": "integer", "minimum": 0}}}}, "section_divider_layout_refs": {"type": "array", "items": {"$ref": "#/$defs/layout_path"}}, "notes_master_relationships": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "repo_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)(?!.*\\\\).+"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "master_path": {"type": "string", "pattern": "^ppt/slideMasters/slideMaster[0-9]+\\.xml$"}, "layout_path": {"type": "string", "pattern": "^ppt/slideLayouts/slideLayout[0-9]+\\.xml$"},
    "master": {"type": "object", "additionalProperties": false, "required": ["master_index", "master_path", "name", "relationship_ids"], "properties": {"master_index": {"type": "integer", "minimum": 0}, "master_path": {"$ref": "#/$defs/master_path"}, "name": {"type": "string"}, "relationship_ids": {"type": "array", "items": {"type": "string", "pattern": "^rId"}}}},
    "geometry": {"type": "object", "additionalProperties": false, "required": ["left", "top", "width", "height"], "properties": {"left": {"type": "integer"}, "top": {"type": "integer"}, "width": {"type": "integer", "minimum": 0}, "height": {"type": "integer", "minimum": 0}}}, "emu_geometry": {"type": "object", "additionalProperties": false, "required": ["left_emu", "top_emu", "width_emu", "height_emu"], "properties": {"left_emu": {"type": "integer", "minimum": 0}, "top_emu": {"type": "integer", "minimum": 0}, "width_emu": {"type": "integer", "minimum": 0}, "height_emu": {"type": "integer", "minimum": 0}}},
    "placeholder": {"type": "object", "additionalProperties": false, "required": ["type", "idx", "geometry"], "properties": {"type": {"type": "string", "minLength": 1}, "idx": {"type": "integer", "minimum": 0}, "geometry": {"$ref": "#/$defs/geometry"}}},
    "layout": {"type": "object", "additionalProperties": false, "required": ["layout_index", "layout_path", "master_path", "name", "placeholders"], "properties": {"layout_index": {"type": "integer", "minimum": 0}, "layout_path": {"$ref": "#/$defs/layout_path"}, "master_path": {"$ref": "#/$defs/master_path"}, "name": {"type": "string"}, "placeholders": {"type": "array", "items": {"$ref": "#/$defs/placeholder"}}}},
    "role": {"type": "object", "additionalProperties": false, "required": ["layout_index", "layout_path", "master_path", "required_placeholders"], "properties": {"layout_index": {"type": "integer", "minimum": 0}, "layout_path": {"$ref": "#/$defs/layout_path"}, "master_path": {"$ref": "#/$defs/master_path"}, "required_placeholders": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
  }
}
