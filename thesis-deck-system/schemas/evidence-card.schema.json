{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "evidence-card.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "kind", "title", "provenance", "source", "claim_support_refs", "claim_contradict_refs", "scope", "verification"],
  "properties": {"schema_version": {"const": "1.0.0"}, "evidence_id": {"pattern": "^E[0-9]{3,}$"}, "kind": {"enum": ["experimental_measurement", "synthetic_measurement", "literature_claim", "synthetic_literature", "literature_figure", "observation_photo", "synthetic_observation", "microscopy_image", "simulation_output", "generated_context"]}, "title": {"type": "string", "minLength": 1}, "provenance": {"type": "string"}, "source": {"type": "object", "required": ["source_id", "uri", "sha256"], "properties": {"source_id": {"type": "string"}, "uri": {"type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$"}, "locator": {"type": "object"}}}, "claim_support_refs": {"type": "array", "items": {"pattern": "^C[0-9]{3,}$"}}, "claim_contradict_refs": {"type": "array", "items": {"pattern": "^C[0-9]{3,}$"}}, "scope": {"type": "object"}, "measurement": {"type": "object"}, "license_or_usage": {"type": "string"}, "verification": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["verified", "synthetic_test_only", "unverified"]}}}},
  "allOf": [{"if": {"properties": {"kind": {"const": "generated_context"}}, "required": ["kind"]}, "then": {"properties": {"claim_support_refs": {"maxItems": 0}, "claim_contradict_refs": {"maxItems": 0}}}}]
}
