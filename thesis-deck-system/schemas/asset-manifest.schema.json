{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "asset-manifest.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "asset_id", "asset_type", "title", "evidence_role", "source_evidence", "path", "mime_type", "sha256", "editable", "provenance", "status"],
  "properties": {"schema_version": {"const": "1.0.0"}, "asset_id": {"type":"string","pattern": "^A[0-9]{3,}$"}, "asset_type": {"enum": ["data_plot", "observation_photo", "mechanism_diagram", "experimental_setup", "literature_figure", "microscopy_image", "generated_context"]}, "title": {"type": "string"}, "evidence_role": {"enum": ["quantitative_evidence", "synthetic_test_evidence", "literature_evidence", "context", "decorative_only"]}, "source_evidence": {"type": "array", "items": {"type":"string","pattern": "^E[0-9]{3,}$"}}, "source_assets": {"type": "array"}, "path": {"type": "string","pattern":"^(?!/)(?![A-Za-z]:)(?!\\\\)"}, "preview_path": {"type": "string","pattern":"^(?!/)(?![A-Za-z]:)(?!\\\\)"}, "mime_type": {"type": "string"}, "sha256": {"type":"string","pattern": "^[0-9a-f]{64}$"}, "editable": {"type": "boolean"}, "generator": {"type": "object"}, "input":{"type":"object"}, "output":{"type":"object"}, "transform_chain": {"type": "array"}, "provenance": {"type": "string"}, "citation_refs": {"type": "array"}, "license_or_usage": {"type": "string"}, "accessibility": {"type": "object"}, "status": {"enum": ["draft", "approved", "rejected"]}},
  "allOf": [{"if": {"properties": {"asset_type": {"const": "generated_context"}}, "required": ["asset_type"]}, "then": {"properties": {"evidence_role": {"const": "decorative_only"}}}}, {"if": {"properties": {"asset_type": {"const": "data_plot"}}, "required": ["asset_type"]}, "then": {"required": ["generator", "transform_chain", "preview_path"]}}]
}
