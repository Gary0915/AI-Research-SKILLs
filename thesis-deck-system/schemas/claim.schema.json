{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "claim.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "claim_id", "revision", "claim_type", "text", "block_ref", "stage", "scope", "epistemic_status", "confidence", "evidence_support_refs", "evidence_contradict_refs", "assumptions", "provenance", "supersedes", "superseded_by", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "claim_id": {"pattern": "^C[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1},
    "claim_type": {"enum": ["observation", "literature_synthesis", "hypothesis", "mechanism", "prediction", "strategy", "result", "discussion", "takeaway"]}, "text": {"type": "string", "minLength": 3},
    "block_ref": {"type": "object", "required": ["block_id", "revision"], "additionalProperties": false, "properties": {"block_id": {"pattern": "^B[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1}}},
    "stage": {"enum": ["observation", "literature", "mechanism", "solution", "experiment", "result", "discussion", "next_step"]},
    "scope": {"type": "object", "required": ["population", "conditions", "exclusions"], "properties": {"population": {"type": "string"}, "conditions": {"type": "string"}, "exclusions": {"type": "array", "items": {"type": "string"}}}},
    "epistemic_status": {"enum": ["proposed", "testing", "supported", "weakened", "refuted", "superseded"]}, "confidence": {"type": "object", "required": ["level", "rationale"], "properties": {"level": {"enum": ["low", "medium", "high"]}, "rationale": {"type": "string"}}},
    "evidence_support_refs": {"type": "array", "items": {"pattern": "^E[0-9]{3,}$"}}, "evidence_contradict_refs": {"type": "array", "items": {"pattern": "^E[0-9]{3,}$"}}, "assumptions": {"type": "array", "items": {"type": ["string", "object"]}},
    "falsifiable_predictions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["prediction_claim_ref", "observation_that_falsifies"], "properties": {"prediction_claim_ref": {"pattern": "^C[0-9]{3,}$"}, "observation_that_falsifies": {"type": "string", "minLength": 3}}}},
    "discriminating_evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["requirement_id", "description"], "properties": {"requirement_id": {"type": "string"}, "description": {"type": "string", "minLength": 3}}}},
    "provenance": {"type": "string"}, "supersedes": {"type": "array", "items": {"pattern": "^C[0-9]{3,}$"}}, "superseded_by": {"type": "array", "items": {"pattern": "^C[0-9]{3,}$"}}, "created_at": {"format": "date-time"}, "updated_at": {"format": "date-time"}
  },
  "allOf": [{"if": {"properties": {"claim_type": {"enum": ["hypothesis", "mechanism"]}}, "required": ["claim_type"]}, "then": {"required": ["falsifiable_predictions", "discriminating_evidence_requirements"]}}]
}
