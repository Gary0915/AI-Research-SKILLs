{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "observation-visual-binding.schema.json", "type": "object", "additionalProperties": false,
  "required": ["observation_id", "empirical_evidence_required", "evidence_refs", "auxiliary_visuals"],
  "properties": {"observation_id": {"type": "string", "pattern": "^OBS[0-9]{3,}$"}, "empirical_evidence_required": {"type": "boolean"}, "observation_evidence_ref": {"oneOf": [{"type": "string", "pattern": "^E[0-9]{3,}$"}, {"type": "null"}]}, "observation_output_ref": {"type": "string", "pattern": "^FOM[0-9]{3,}$"}, "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}, "uniqueItems": true}, "auxiliary_visuals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["figure_id", "figure_type", "evidence_status"], "properties": {"figure_id": {"type": "string", "pattern": "^FIG[0-9A-Z]+$"}, "figure_type": {"type": "string", "enum": ["concept_illustration"]}, "evidence_status": {"const": "non_evidence"}}}}},
  "allOf": [{"if": {"properties": {"empirical_evidence_required": {"const": true}}, "required": ["empirical_evidence_required"]}, "then": {"required": ["observation_evidence_ref", "observation_output_ref"], "properties": {"evidence_refs": {"minItems": 1}}}}]
}
