{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "skill-routing.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "skills", "routes"],
  "properties": {"schema_version": {"const": "3.0.0"}, "skills": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["skill_id", "trigger", "output_contract", "forbidden_responsibilities", "handoff", "qa_owner"], "properties": {"skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "trigger": {"type": "string", "enum": ["fabrication_process", "mechanism", "experiment", "result", "observation"]}, "output_contract": {"type": "string", "enum": ["fabrication-process", "mechanism-spec", "experiment-schematic", "figure-output"]}, "forbidden_responsibilities": {"type": "array", "items": {"type": "string", "enum": ["mechanism_explanation", "measurement_schematic", "fabrication_process"]}, "uniqueItems": true}, "handoff": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "qa_owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}}}}, "routes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["request_kind", "skill_id", "next_skill_id"], "properties": {"request_kind": {"type": "string", "enum": ["fabrication_process", "mechanism", "experiment", "result", "observation"]}, "skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "next_skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}}}}}
}
