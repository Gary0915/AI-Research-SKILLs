{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis-deck-system.local/schemas/native-figure-compilation-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "compiler_id", "compiler_version", "figure_id", "figure_revision", "approved_figure", "svg_profile", "registry", "view_box", "target_box", "coordinate_transform", "feature_decisions", "objects", "fallback_records", "plan_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"type": "string", "pattern": "^NFCP-FIG[0-9]{3}-[A-Za-z0-9._-]+$"},
    "compiler_id": {"const": "TDS-SVG-NATIVE-COMPILER-001"},
    "compiler_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "figure_id": {"type": "string", "pattern": "^FIG[0-9]{3}$"},
    "figure_revision": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "approved_figure": {"$ref": "#/$defs/approvedFigure"},
    "svg_profile": {"$ref": "#/$defs/svgProfile"},
    "registry": {"$ref": "#/$defs/registry"},
    "view_box": {"$ref": "#/$defs/box"},
    "target_box": {"$ref": "#/$defs/targetBox"},
    "coordinate_transform": {"$ref": "#/$defs/transform"},
    "feature_decisions": {"type": "array", "items": {"$ref": "#/$defs/featureDecision"}},
    "objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/object"}},
    "fallback_records": {"type": "array", "items": {"$ref": "#/$defs/fallback"}},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approvedFigure": {"type": "object", "additionalProperties": false, "required": ["manifest_id", "manifest_hash", "critic_report_id", "critic_report_hash"], "properties": {"manifest_id": {"type": "string", "pattern": "^SSE-FIG[0-9]{3}-[0-9]{3}$"}, "manifest_hash": {"$ref": "#/$defs/hash"}, "critic_report_id": {"type": "string", "pattern": "^FCR-FIG[0-9]{3}-[0-9]{3}$"}, "critic_report_hash": {"$ref": "#/$defs/hash"}}},
    "svgProfile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_version", "canonical_sha256"], "properties": {"profile_id": {"const": "SSVG-P001"}, "profile_version": {"const": "1.0.0"}, "canonical_sha256": {"$ref": "#/$defs/hash"}}},
    "registry": {"type": "object", "additionalProperties": false, "required": ["registry_id", "registry_version", "registry_sha256"], "properties": {"registry_id": {"const": "SNCR001"}, "registry_version": {"const": "1.0.0"}, "registry_sha256": {"$ref": "#/$defs/hash"}}},
    "box": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "targetBox": {"type": "object", "additionalProperties": false, "required": ["left", "top", "width", "height"], "properties": {"left": {"type": "number"}, "top": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "transform": {"type": "object", "additionalProperties": false, "required": ["scale_x", "scale_y", "translate_x", "translate_y"], "properties": {"scale_x": {"type": "number", "exclusiveMinimum": 0}, "scale_y": {"type": "number", "exclusiveMinimum": 0}, "translate_x": {"type": "number"}, "translate_y": {"type": "number"}}},
    "featureDecision": {"type": "object", "additionalProperties": false, "required": ["feature_id", "capability_state", "compilation_decision"], "properties": {"feature_id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "capability_state": {"enum": ["NATIVE_EXACT", "NATIVE_NORMALIZED", "VECTOR_FALLBACK", "RASTER_FALLBACK", "UNSUPPORTED", "UNKNOWN"]}, "compilation_decision": {"enum": ["DRAWINGML_EMITTED", "SVG_VECTOR_FALLBACK", "BLOCKED_UNSUPPORTED", "BLOCKED_UNKNOWN_MAPPING"]}}},
    "geometry": {"type": "object", "additionalProperties": false, "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number"}, "height": {"type": "number"}, "cx": {"type": "number"}, "cy": {"type": "number"}, "r": {"type": "number"}, "rx": {"type": "number"}, "ry": {"type": "number"}, "x1": {"type": "number"}, "y1": {"type": "number"}, "x2": {"type": "number"}, "y2": {"type": "number"}}},
    "style": {"type": "object", "additionalProperties": false, "properties": {"fill": {"type": "string", "maxLength": 32}, "stroke": {"type": "string", "maxLength": 32}, "stroke-width": {"type": "string", "maxLength": 32}, "stroke-dasharray": {"type": "string", "maxLength": 64}, "font-family": {"type": "string", "maxLength": 128}, "font-size": {"type": "string", "maxLength": 32}, "font-weight": {"type": "string", "maxLength": 32}, "marker-start": {"type": "string", "maxLength": 128}, "marker-end": {"type": "string", "maxLength": 128}, "transform": {"type": "string", "maxLength": 128}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["order", "svg_object_id", "semantic_role", "shape_kind", "geometry", "text", "style", "outcome", "fallback_reason", "parent_relation"], "properties": {"order": {"type": "integer", "minimum": 0}, "svg_object_id": {"type": "string", "pattern": "^obj-[A-Za-z0-9_-]+$"}, "semantic_role": {"type": "string", "pattern": "^[a-z_]+$"}, "shape_kind": {"enum": ["group", "rect", "ellipse", "line", "polyline", "polygon", "text", "marker", "svg_vector"]}, "geometry": {"$ref": "#/$defs/geometry"}, "text": {"type": ["string", "null"], "maxLength": 4096}, "style": {"$ref": "#/$defs/style"}, "outcome": {"enum": ["DRAWINGML_EMITTED", "SVG_VECTOR_FALLBACK", "BLOCKED_UNSUPPORTED", "BLOCKED_UNKNOWN_MAPPING"]}, "fallback_reason": {"type": ["string", "null"], "enum": [null, "unsupported_svg_subtree"]}, "parent_relation": {"type": ["string", "null"], "pattern": "^obj-[A-Za-z0-9_-]+$"}}},
    "fallback": {"type": "object", "additionalProperties": false, "required": ["object_id", "outcome", "reason", "source_svg_sha256"], "properties": {"object_id": {"type": "string", "pattern": "^obj-[A-Za-z0-9_-]+$"}, "outcome": {"enum": ["SVG_VECTOR_FALLBACK", "BLOCKED_UNSUPPORTED", "BLOCKED_UNKNOWN_MAPPING"]}, "reason": {"type": "string", "enum": ["unsupported_svg_subtree"]}, "source_svg_sha256": {"$ref": "#/$defs/hash"}}}
  }
}
