{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figure-routing-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["figure_plan_id", "visual_class", "scientific_purpose", "evidence_status", "scientific_claim_support", "source_refs", "claim_refs", "evidence_refs", "hypothesis_layer_ref", "research_block_refs", "stage_ref", "source_cursor", "provenance_rule_ids"],
  "properties": {
    "figure_plan_id": {"type":"string","pattern":"^FPL[0-9]{3,}$"},
    "visual_class": {"enum":["quantitative_measured_result","real_experiment_photo","literature_figure","mechanism_explanation","experiment_setup","fabrication_process","fishbone_history","fair_comparison","image_matrix","organic_concept"]},
    "scientific_purpose":{"type":"string","minLength":1,"maxLength":160}, "evidence_status":{"enum":["empirical","literature_evidence","non_evidence"]}, "scientific_claim_support":{"enum":["required","allowed","forbidden"]},
    "source_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[EA][0-9]{3,}$"}}, "claim_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^C[0-9]{3,}$"}}, "evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^E[0-9]{3,}$"}},
    "hypothesis_layer_ref":{"type":"string","pattern":"^H[0-9]{3,}$"}, "research_block_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^B[0-9]{3,}$"}}, "stage_ref":{"type":"string","pattern":"^ST-[A-Z0-9-]+$"}, "source_cursor":{"type":"integer","minimum":1}, "requested_archetype":{"type":"string","pattern":"^A(0[1-9]|1[0-8])$"}, "provenance_rule_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^CP4-[A-Z0-9-]+$"}},
    "ai_generation_requested":{"type":"boolean"}, "style_profile_ref":{"type":"string","pattern":"^VSP[0-9]{3,}$"}, "structured_edges":{"type":"integer","minimum":0},
    "observation_evidence_ref":{"type":"string","pattern":"^E[0-9]{3,}$"}, "experimental_evidence_slot_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^E[0-9]{3,}$"}}, "quantitative_result_evidence_slot_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^E[0-9]{3,}$"}}, "literature_figure_evidence_slot_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^E[0-9]{3,}$"}},
    "fabrication_steps":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["ordinal","condition_state"],"properties":{"ordinal":{"type":"integer","minimum":1},"condition_state":{"enum":["known","unknown"]},"material_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][0-9]{3,}$"}}}}},
    "fishbone_binding":{"type":"object","additionalProperties":false,"required":["fishbone_revision_ref","focus_ref","history_ref"],"properties":{"fishbone_revision_ref":{"type":"string","pattern":"^FB[0-9]{3,}-R[0-9]{3,}$"},"focus_ref":{"type":"string","pattern":"^BR[0-9]{3,}$"},"history_ref":{"type":"string","pattern":"^H[0-9]{3,}$"}}}
  },
  "allOf":[
    {"if":{"properties":{"visual_class":{"const":"organic_concept"}},"required":["visual_class"]},"then":{"properties":{"evidence_status":{"const":"non_evidence"},"scientific_claim_support":{"const":"forbidden"},"claim_refs":{"maxItems":0},"evidence_refs":{"maxItems":0},"source_refs":{"maxItems":0},"observation_evidence_ref":false,"experimental_evidence_slot_refs":{"maxItems":0},"quantitative_result_evidence_slot_refs":{"maxItems":0},"literature_figure_evidence_slot_refs":{"maxItems":0}}}},
    {"if":{"properties":{"visual_class":{"const":"fabrication_process"}},"required":["visual_class"]},"then":{"required":["fabrication_steps"]}},
    {"if":{"properties":{"visual_class":{"const":"fishbone_history"}},"required":["visual_class"]},"then":{"required":["fishbone_binding"]}}
  ]
}
