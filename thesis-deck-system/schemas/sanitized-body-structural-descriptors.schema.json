{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanitized-body-structural-descriptors.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "descriptor"],
  "properties": {"schema_version": {"const": "1.0.0"}, "descriptor": {"$ref": "#/$defs/descriptor"}},
  "$defs": {
    "basis": {"enum": ["measured", "derived", "not_observable_structurally"]},
    "scope": {"enum": ["slide_master", "slide_layout", "theme", "slide_recurrence_derived", "not_observable_structurally"]},
    "geometry": {"type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h", "basis"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "basis": {"$ref": "#/$defs/basis"}}},
    "style": {"type": "object", "additionalProperties": false, "required": ["fill_role", "stroke_role", "line_width_pt", "basis"], "properties": {"fill_role": {"enum": ["none", "background", "neutral", "accent", "emphasis", "unknown", "theme:accent1", "theme:accent2", "theme:accent3", "theme:accent4", "theme:accent5", "theme:accent6", "theme:dk1", "theme:dk2", "theme:lt1", "theme:lt2", "theme:hlink", "theme:folhlink"]}, "stroke_role": {"enum": ["none", "background", "neutral", "accent", "emphasis", "unknown", "theme:accent1", "theme:accent2", "theme:accent3", "theme:accent4", "theme:accent5", "theme:accent6", "theme:dk1", "theme:dk2", "theme:lt1", "theme:lt2", "theme:hlink", "theme:folhlink"]}, "line_width_pt": {"type": "number", "minimum": 0, "maximum": 20}, "basis": {"$ref": "#/$defs/basis"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["value", "basis", "evidence_state", "supporting_object_ids"], "properties": {"value": {"anyOf": [{"type": "number"}, {"type": "integer"}, {"type": "null"}, {"enum": ["adjacent", "overlapping", "separate"]}]}, "basis": {"$ref": "#/$defs/basis"}, "evidence_state": {"enum": ["measured", "derived", "unavailable"]}, "supporting_object_ids": {"type": "array", "items": {"type": "string", "pattern": "^[OP][0-9]{3,}$"}}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["object_id", "object_class", "primitive_type", "geometry", "group_id", "style", "basis", "source_scope"], "properties": {"object_id": {"type": "string", "pattern": "^O[0-9]{3,}$"}, "object_class": {"enum": ["text", "picture", "table", "chart", "native_shape", "connector", "group", "line", "unknown"]}, "primitive_type": {"enum": ["textbox", "picture", "table", "chart", "rect", "round_rect", "ellipse", "line", "arrow", "group", "unknown"]}, "geometry": {"$ref": "#/$defs/geometry"}, "group_id": {"type": ["string", "null"]}, "style": {"$ref": "#/$defs/style"}, "basis": {"$ref": "#/$defs/basis"}, "source_scope": {"$ref": "#/$defs/scope"}}},
    "connector": {"type": "object", "additionalProperties": false, "required": ["object_id", "orientation", "start", "end", "head_arrow", "tail_arrow", "directedness", "flip_h", "flip_v", "basis", "source_scope"], "properties": {"object_id": {"type": "string", "pattern": "^O[0-9]{3,}$"}, "orientation": {"enum": ["horizontal", "vertical", "diagonal", "unknown"]}, "start": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}, "end": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}, "head_arrow": {"enum": ["none", "triangle", "stealth", "oval", "unknown"]}, "tail_arrow": {"enum": ["none", "triangle", "stealth", "oval", "unknown"]}, "directedness": {"enum": ["plain", "directed"]}, "flip_h": {"type": "boolean"}, "flip_v": {"type": "boolean"}, "basis": {"$ref": "#/$defs/basis"}, "source_scope": {"$ref": "#/$defs/scope"}}},
    "measurement": {"type": "object", "additionalProperties": false, "required": ["slide_id", "measurement_basis", "objects", "connectors", "groups", "panels", "metrics", "style_roles"], "properties": {"slide_id": {"type": "string", "pattern": "^SL[0-9]{3,}$"}, "measurement_basis": {"$ref": "#/$defs/basis"}, "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}}, "connectors": {"type": "array", "items": {"$ref": "#/$defs/connector"}}, "groups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["group_id", "member_count", "basis", "source_scope"], "properties": {"group_id": {"type": "string", "pattern": "^G[0-9]{3,}$"}, "member_count": {"type": "integer", "minimum": 1}, "basis": {"$ref": "#/$defs/basis"}, "source_scope": {"$ref": "#/$defs/scope"}}}}, "panels": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["panel_id", "geometry", "basis"], "properties": {"panel_id": {"type": "string", "pattern": "^P[0-9]{3,}$"}, "geometry": {"$ref": "#/$defs/geometry"}, "basis": {"$ref": "#/$defs/basis"}}}}, "metrics": {"type": "object", "additionalProperties": false, "required": ["text_area_ratio", "figure_area_ratio", "dominant_figure_ratio", "figure_text_ratio", "annotation_density", "whitespace_fraction", "comparison_symmetry", "matrix_rows", "matrix_columns", "panel_count", "caption_candidate_count", "callout_candidate_count", "photo_schematic_relation"], "properties": {"text_area_ratio": {"$ref": "#/$defs/metric"}, "figure_area_ratio": {"$ref": "#/$defs/metric"}, "dominant_figure_ratio": {"$ref": "#/$defs/metric"}, "figure_text_ratio": {"$ref": "#/$defs/metric"}, "annotation_density": {"$ref": "#/$defs/metric"}, "whitespace_fraction": {"$ref": "#/$defs/metric"}, "comparison_symmetry": {"$ref": "#/$defs/metric"}, "matrix_rows": {"$ref": "#/$defs/metric"}, "matrix_columns": {"$ref": "#/$defs/metric"}, "panel_count": {"$ref": "#/$defs/metric"}, "caption_candidate_count": {"$ref": "#/$defs/metric"}, "callout_candidate_count": {"$ref": "#/$defs/metric"}, "photo_schematic_relation": {"$ref": "#/$defs/metric"}}}, "style_roles": {"type": "array", "items": {"$ref": "#/$defs/style"}}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["family", "confidence", "evidence_basis"], "properties": {"family": {"enum": ["formal_shell_divider", "hypothesis_problem", "photo_schematic", "control_proposed_comparison", "experiment_schematic", "result_single", "result_comparison", "result_discussion", "image_matrix", "fishbone_research_map", "fabrication_process_flow", "other_insufficient_structural_evidence"]}, "confidence": {"enum": ["structurally_supported", "provisional", "insufficient_structural_evidence"]}, "evidence_basis": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}}}},
    "descriptor": {"type": "object", "additionalProperties": false, "required": ["alias_uri", "source_sha256", "profile_id", "slide_size", "slide_count", "candidate_families", "body_measurements"], "properties": {"alias_uri": {"const": "private://layout_exemplar_2"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "profile_id": {"type": "string", "pattern": "^P3-[A-Z0-9-]+$"}, "slide_size": {"type": "object", "additionalProperties": false, "required": ["width", "height", "basis"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "basis": {"$ref": "#/$defs/basis"}}}, "slide_count": {"type": "integer", "minimum": 1}, "candidate_families": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}, "body_measurements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measurement"}}}}
  }
}
