{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "hypothesis-transition.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "transition_id", "from_layer_ref", "to_layer_ref", "previous_hypothesis_claim_ref", "key_result_refs", "unexplained", "observation_or_uncertainty_refs", "rationale", "new_hypothesis_claim_ref", "decision_refs", "source_event_cursor", "created_at"],
  "properties": {"schema_version": {"const": "2.0.0"}, "transition_id": {"type": "string", "pattern": "^TR-H[0-9]{3}-H[0-9]{3}$"}, "from_layer_ref": {"type": "string", "pattern": "^H[0-9]{3}$"}, "to_layer_ref": {"type": "string", "pattern": "^H[0-9]{3}$"}, "previous_hypothesis_claim_ref": {"type": "string", "pattern": "^C[0-9]{3,}$"}, "key_result_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^RES[0-9]{3,}$"}}, "unexplained": {"type": "string", "minLength": 1}, "observation_or_uncertainty_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(E|DISC-H)[0-9]{3,}$"}}, "rationale": {"type": "string", "minLength": 1}, "new_hypothesis_claim_ref": {"type": "string", "pattern": "^C[0-9]{3,}$"}, "decision_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^D[0-9]{3,}$"}}, "source_event_cursor": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}}
}
