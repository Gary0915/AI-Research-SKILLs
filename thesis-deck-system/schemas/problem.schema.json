{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "problem.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "problem_id", "hypothesis_layer_ref", "problem_statement", "previous_findings", "unresolved_conflict", "research_question", "evidence_refs", "derived_from_decision_refs", "scope", "source_event_cursor", "created_at"],
  "properties": {"schema_version": {"const": "2.0.0"}, "problem_id": {"type": "string", "pattern": "^P[0-9]{3,}$"}, "hypothesis_layer_ref": {"type": "string", "pattern": "^H[0-9]{3}$"}, "problem_statement": {"type": "string", "minLength": 1}, "previous_findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "unresolved_conflict": {"type": "string", "minLength": 1}, "research_question": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}}, "derived_from_decision_refs": {"type": "array", "items": {"type": "string", "pattern": "^D[0-9]{3,}$"}}, "scope": {"type": "string", "minLength": 1}, "source_event_cursor": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}}
}
