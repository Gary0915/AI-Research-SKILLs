{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "real-research-visual-acceptance-schema-closure-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["inventory_id", "candidate_schema_component_count", "checked_schema_count", "checked_object_node_count", "open_node_count", "corrected_node_count", "recursive_closure_status", "schemas"],
  "properties": {
    "inventory_id": {"const": "RRVA-SCHEMA-CLOSURE-001"},
    "candidate_schema_component_count": {"type": "integer", "minimum": 1},
    "checked_schema_count": {"type": "integer", "minimum": 1},
    "checked_object_node_count": {"type": "integer", "minimum": 1},
    "open_node_count": {"const": 0},
    "corrected_node_count": {"type": "integer", "minimum": 0},
    "recursive_closure_status": {"const": "pass"},
    "schemas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schema"}}
  },
  "$defs": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_path", "object_node_count", "open_node_count", "nodes"],
      "properties": {
        "schema_path": {"type": "string", "pattern": "^thesis-deck-system/schemas/.+\\.schema\\.json$"},
        "object_node_count": {"type": "integer", "minimum": 0},
        "open_node_count": {"const": 0},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_pointer", "node_type", "status", "reason"],
      "properties": {
        "json_pointer": {"type": "string", "pattern": "^\\$"},
        "node_type": {"const": "object"},
        "status": {"const": "closed"},
        "reason": {"enum": ["additional_properties_false", "bounded_typed_map"]}
      }
    }
  }
}
