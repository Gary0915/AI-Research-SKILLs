{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "professor-profile.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "project_id", "primary_language", "technical_term_policy", "narrative_rules", "meeting_rules", "master_deck_rules", "content_rules", "visual_exemplars", "font_policy", "change_log", "provenance", "created_at", "updated_at"],
  "properties": {"schema_version": {"const": "1.0.0"}, "profile_id": {"type": "string", "pattern": "^PROF-"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "project_id": {"type": "string"}, "primary_language": {"type": "string", "const": "zh-TW"}, "technical_term_policy": {"type": "string"}, "narrative_rules": {"type": "object", "required": ["scientific_method_required", "require_question_before_data", "literature_must_synthesize_to_hypothesis_or_strategy", "discussion_must_update_decision", "preserve_failed_and_changed_hypotheses", "persistent_orientation_view"]}, "meeting_rules": {"type": "object", "required": ["require_previous_commitments", "require_current_progress", "require_next_steps_and_timing", "require_blockers_dependencies_and_parallel_work"]}, "master_deck_rules": {"type": "object", "required": ["cumulative_growth", "meeting_and_defense_are_projections"]}, "content_rules": {"type": "object", "required": ["figures_dominate", "text_supports_interpretation", "high_density_allowed_only_when_structured"]}, "visual_exemplars": {"type": "object", "required": ["template_language_refs", "content_layout_primary_ref"]}, "font_policy": {"type": "object", "required": ["final_fonts_locked", "required_fonts", "fallback_fonts", "source"]}, "change_log": {"type": "array", "minItems": 1}, "provenance": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}
}
