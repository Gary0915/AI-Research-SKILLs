{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "layout-archetype.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "archetype_id", "name", "semantic_purpose", "allowed_stages", "required_bindings", "asset_limits", "title_requirement", "take_home_requirement", "text_budget", "citation_zone", "native_layout_role", "failure_policy", "professor_rules", "zh_tw_typography", "visual_qa_checks"],
  "properties": {"schema_version": {"const": "2.0.0"}, "archetype_id": {"type": "string", "pattern": "^A(0[1-9]|1[0-8])$"}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}, "semantic_purpose": {"type": "string", "minLength": 1}, "allowed_stages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "required_bindings": {"type": "array", "items": {"type": "string", "minLength": 1}}, "asset_limits": {"type": "object", "additionalProperties": false, "required": ["min", "max", "allowed_types"], "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}, "allowed_types": {"type": "array", "items": {"type": "string", "minLength": 1}}}}, "title_requirement": {"type": "string", "minLength": 1}, "take_home_requirement": {"type": "string", "minLength": 1}, "text_budget": {"type": "integer", "minimum": 1}, "citation_zone": {"type": "string", "minLength": 1}, "native_layout_role": {"type": "string", "minLength": 1}, "failure_policy": {"type": "string", "enum": ["split", "block", "alternate"]}, "professor_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "zh_tw_typography": {"type": "object", "additionalProperties": false, "required": ["minimum_font_pt", "line_height", "max_title_chars"], "properties": {"minimum_font_pt": {"type": "number", "minimum": 14}, "line_height": {"type": "number", "minimum": 1}, "max_title_chars": {"type": "integer", "minimum": 8}}}, "visual_qa_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
}
