{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis-deck-system.local/schemas/incremental-lineage-acceptance-proof.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["proof_id", "scenarios", "decision_counts", "stale_mixed_generation_rejection_count", "shell_override_by_body_reference_count", "aggregate_status"],
  "properties": {
    "proof_id": {"const": "IDL-ACCEPTANCE-PROOF-001"},
    "scenarios": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/scenario"}},
    "decision_counts": {"type": "object", "additionalProperties": false, "required": ["reuse_exact", "append_new", "new_revision", "rebuild_dependency_changed", "exclude_from_meeting_view_only"], "properties": {"reuse_exact": {"type": "integer", "minimum": 0}, "append_new": {"type": "integer", "minimum": 0}, "new_revision": {"type": "integer", "minimum": 0}, "rebuild_dependency_changed": {"type": "integer", "minimum": 0}, "exclude_from_meeting_view_only": {"type": "integer", "minimum": 0}}},
    "stale_mixed_generation_rejection_count": {"type": "integer", "minimum": 1},
    "shell_override_by_body_reference_count": {"const": 0},
    "aggregate_status": {"enum": ["pass", "fail"]}
  },
  "$defs": {
    "scenario": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "status", "decision_ids"], "properties": {"scenario_id": {"enum": ["IDL-A", "IDL-B", "IDL-C", "IDL-D", "IDL-E", "IDL-F", "IDL-G", "IDL-H"]}, "status": {"enum": ["pass", "fail"]}, "decision_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
  }
}
