{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scientific-figure-spec.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"enum": ["3.0.0", "4.0.0"]}, "figure_id": {"type":"string","pattern":"^FIG[0-9]{3,}$"},
    "figure_type": {"enum":["scientific_plot","vector_diagram","native_shape_figure","real_photo","literature_figure","concept_illustration","mechanism_diagram","experiment_schematic","fabrication_process_diagram","fishbone_diagram","comparison_diagram","image_matrix_figure"]},
    "scientific_purpose":{"type":"string","minLength":1,"maxLength":160}, "evidence_status":{"enum":["empirical","literature_evidence","non_evidence"]},
    "source_refs":{"type":"array","items":{"type":"string","pattern":"^[EA][0-9]{3,}$"}}, "claim_refs":{"type":"array","items":{"type":"string","pattern":"^C[0-9]{3,}$"}}, "evidence_refs":{"type":"array","items":{"type":"string","pattern":"^E[0-9]{3,}$"}}, "hypothesis_layer_ref":{"type":"string","pattern":"^H[0-9]{3,}$"}, "research_block_refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^B[0-9]{3,}$"}}, "stage_ref":{"type":"string","pattern":"^ST-[A-Z0-9-]+$"}, "source_cursor":{"type":"integer","minimum":1}, "director_skill":{"type":"string","pattern":"^[a-z][a-z0-9-]+$"}, "renderer":{"type":"string","pattern":"^[a-z][a-z0-9_-]+$"}, "renderer_class":{"type":"string","pattern":"^[a-z][a-z0-9_-]+$"}, "style_profile_ref":{"type":"string","pattern":"^VSP[0-9]{3,}$"},
    "canvas":{"type":"object","additionalProperties":false,"required":["width","height"],"properties":{"width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0}}},
    "components":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{}}},"connections":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{}}},"annotations":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{}}},"labels":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{}}},"visual_states":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{}}},
    "provenance":{"oneOf":[{"type":"object","additionalProperties":false,"required":["rule_ids"],"properties":{"rule_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^CP4-[A-Z0-9-]+$"}}}},{"type":"object","additionalProperties":false,"required":["source_cursor"],"properties":{"source_cursor":{"type":"integer","minimum":1}}}]}, "output_targets":{"type":"array","minItems":1,"items":{"enum":["svg_vector","source_evidence_asset","extracted_source_figure","generated_non_evidence_substrate"]}}, "qa_requirements":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[a-z0-9_-]+$"}},
    "specialist_payload":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"steps":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["ordinal","condition_state"],"properties":{"ordinal":{"type":"integer","minimum":1},"condition_state":{"enum":["known","unknown"]}}}},"fishbone_binding":{"type":"object","additionalProperties":false,"required":["fishbone_revision_ref","focus_ref","history_ref"],"properties":{"fishbone_revision_ref":{"type":"string","pattern":"^FB[0-9]{3,}-R[0-9]{3,}$"},"focus_ref":{"type":"string","pattern":"^BR[0-9]{3,}$"},"history_ref":{"type":"string","pattern":"^H[0-9]{3,}$"}}}}}
  },
  "allOf":[{"oneOf":[
    {"properties":{"schema_version":{"const":"3.0.0"}},"required":["figure_id","figure_type","scientific_purpose","evidence_status","source_refs","claim_refs","hypothesis_layer_ref","research_block_refs","director_skill","renderer","style_profile_ref","canvas","components","connections","annotations","labels","visual_states","provenance","output_targets","qa_requirements"]},
    {"properties":{"schema_version":{"const":"4.0.0"}},"required":["figure_id","figure_type","scientific_purpose","evidence_status","source_refs","claim_refs","evidence_refs","hypothesis_layer_ref","research_block_refs","stage_ref","source_cursor","director_skill","renderer_class","style_profile_ref","canvas","components","connections","annotations","labels","visual_states","provenance","output_targets","qa_requirements","specialist_payload"]}
  ]},{"if":{"properties":{"figure_type":{"const":"concept_illustration"}},"required":["figure_type"]},"then":{"properties":{"evidence_status":{"const":"non_evidence"},"claim_refs":{"maxItems":0}}}}]
}
