{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "professor-visual-review-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_manifest_id", "cases", "pending_human_decision_count", "aggregate_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "review_manifest_id": {"const": "PVRM-001"},
    "cases": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/case"}},
    "pending_human_decision_count": {"type": "integer", "minimum": 6},
    "real_candidate_slide_count": {"type": "integer", "minimum": 12},
    "golden_appendix_slide_count": {"const": 10},
    "candidate_preview_status": {"enum": ["pptx_review_ready_render_pending_discovery", "blocked_environment", "rendered"]},
    "aggregate_status": {"const": "ready_for_human_visual_acceptance_review"}
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_slide_id", "fixture_id", "scientific_content_dependency_hash", "candidate_ids", "candidates", "selected_by_algorithm_candidate_id", "human_selection", "human_status", "review_dimensions"],
      "properties": {
        "logical_slide_id": {"type": "string", "pattern": "^RRVA-R"},
        "fixture_id": {"type": "string", "pattern": "^R"},
        "scientific_content_dependency_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidate_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^RRVC-"}},
        "candidates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/candidate"}},
        "selected_by_algorithm_candidate_id": {"type": "string", "pattern": "^RRVC-"},
        "human_selection": {"type": "null"}, "human_status": {"const": "pending"},
        "review_dimensions": {"type": "array", "minItems": 8, "items": {"enum": ["message_clarity", "figure_prominence", "text_density", "typography", "caption", "technical_density", "group_meeting_tsmc_fit", "overall_preference"]}}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "body_family_id", "composition_strategy", "body_source_class", "physical_plan_hash", "algorithm_fit"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^RRVC-"}, "body_family_id": {"type": "string", "pattern": "^BCF-"},
        "composition_strategy": {"type": "string", "pattern": "^[a-z_]+$"},
        "body_source_class": {"enum": ["group_meeting_dominant", "tsmc_dominant", "hybrid_body", "historical_reuse"]},
        "physical_plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pptx_slide_index": {"type": "integer", "minimum": 1}, "body_source_fit_status": {"enum": ["pass", "fail"]},
        "algorithm_fit": {"$ref": "#/$defs/fit"}
      }
    },
    "fit": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_fit", "capacity_fit", "evidence_fit", "primary_visual_prominence_fit", "text_density_fit", "caption_density_fit", "comparison_alignment_fit", "technical_evidence_hierarchy_fit"],
      "properties": {
        "semantic_fit": {"type": "integer", "minimum": 0, "maximum": 5}, "capacity_fit": {"type": "integer", "minimum": 0, "maximum": 5},
        "evidence_fit": {"type": "integer", "minimum": 0, "maximum": 5}, "primary_visual_prominence_fit": {"type": "integer", "minimum": 0, "maximum": 5},
        "text_density_fit": {"type": "integer", "minimum": 0, "maximum": 5}, "caption_density_fit": {"type": "integer", "minimum": 0, "maximum": 5},
        "comparison_alignment_fit": {"type": "integer", "minimum": 0, "maximum": 5}, "technical_evidence_hierarchy_fit": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    }
  }
}
