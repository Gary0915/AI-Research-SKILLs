{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physical-composition-plans.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "planner_version", "records"],
  "properties": {"schema_version": {"const": "2.0.0"}, "planner_version": {"const": "2.0.0"}, "records": {"type": "array", "items": {"$ref": "#/$defs/plan"}}},
  "$defs": {
    "box": {"type": "object", "additionalProperties": false, "required": ["left", "top", "width", "height"], "properties": {"left": {"type": "number"}, "top": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "region": {"type": "object", "additionalProperties": false, "required": ["region_id", "semantic_role", "presentation_role", "x", "y", "w", "h", "anchor_relationship", "z_order_class", "required", "accepted_content_kinds", "caption_behavior", "callout_behavior", "connector_behavior"], "properties": {"region_id": {"type": "string"}, "semantic_role": {"type": "string"}, "presentation_role": {"type": "string"}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "anchor_relationship": {"const": "content_bounds"}, "z_order_class": {"enum": ["body", "emphasis"]}, "required": {"type": "boolean"}, "accepted_content_kinds": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "caption_behavior": {"enum": ["none", "attached"]}, "callout_behavior": {"enum": ["none", "emphasis"]}, "connector_behavior": {"enum": ["none", "allowed"]}}},
    "physical_region": {"type": "object", "additionalProperties": false, "required": ["region_id", "semantic_role", "presentation_role", "x", "y", "w", "h", "anchor_relationship", "z_order_class", "required", "accepted_content_kinds", "caption_behavior", "callout_behavior", "connector_behavior", "geometry", "item_id", "synthetic_placeholder"], "properties": {"region_id": {"type": "string"}, "semantic_role": {"type": "string"}, "presentation_role": {"type": "string"}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "anchor_relationship": {"const": "content_bounds"}, "z_order_class": {"enum": ["body", "emphasis"]}, "required": {"type": "boolean"}, "accepted_content_kinds": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "caption_behavior": {"enum": ["none", "attached"]}, "callout_behavior": {"enum": ["none", "emphasis"]}, "connector_behavior": {"enum": ["none", "allowed"]}, "geometry": {"$ref": "#/$defs/box"}, "item_id": {"type": "string"}, "synthetic_placeholder": {"type": "boolean"}}},
    "assignment": {"type": "object", "additionalProperties": false, "required": ["item_id", "region_id", "content_kind", "geometry"], "properties": {"item_id": {"type": "string"}, "region_id": {"type": "string"}, "content_kind": {"type": "string"}, "geometry": {"$ref": "#/$defs/box"}}},
    "plan": {"type": "object", "additionalProperties": false, "required": ["physical_plan_id", "slide_id", "candidate_id", "body_family_id", "body_recipe_id", "body_style_recipe_id", "spacing_scale_id", "style_authority_status", "shell_profile_id", "content_bounds", "regions", "physical_regions", "content_item_assignments", "required_role_coverage_status", "overflow_status", "geometry_hash", "physical_composition_hash", "unassigned_required_region_ids"], "properties": {"physical_plan_id": {"type": "string"}, "slide_id": {"type": "string"}, "candidate_id": {"type": "string"}, "body_family_id": {"type": "string"}, "body_recipe_id": {"type": "string"}, "body_style_recipe_id": {"type": "string", "pattern": "^BSR-"}, "spacing_scale_id": {"const": "PSS-001"}, "style_authority_status": {"const": "body_only_no_shell_override"}, "shell_profile_id": {"const": "VSP003"}, "content_bounds": {"$ref": "#/$defs/box"}, "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}}, "physical_regions": {"type": "array", "items": {"$ref": "#/$defs/physical_region"}}, "content_item_assignments": {"type": "array", "items": {"$ref": "#/$defs/assignment"}}, "required_role_coverage_status": {"enum": ["pass", "fail"]}, "overflow_status": {"enum": ["pass", "fail"]}, "geometry_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "physical_composition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "unassigned_required_region_ids": {"type": "array", "items": {"type": "string"}}}}
  }
}
