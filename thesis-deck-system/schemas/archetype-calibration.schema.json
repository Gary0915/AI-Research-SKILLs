{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"archetype-calibration.schema.json","type":"object","additionalProperties":false,"required":["schema_version","archetypes"],"properties":{"schema_version":{"const":"1.0.0"},"archetypes":{"type":"array","minItems":18,"items":{"$ref":"#/$defs/archetype"}}},"$defs":{"metric":{"type":"object","additionalProperties":false,"required":["metric_name","observed_value","target_range","evidence_tier","status"],"properties":{"metric_name":{"type":"string","pattern":"^[a-z][a-z0-9_]{1,63}$"},"observed_value":{"type":"integer","minimum":0},"target_range":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":0}},"evidence_tier":{"enum":["structurally_supported","provisional","insufficient_evidence"]},"status":{"enum":["provisional","insufficient_evidence","not_measured"]}}},"archetype":{"type":"object","additionalProperties":false,"required":["archetype_id","archetype_source_hash","descriptor_refs","measured_metrics","structural_geometry","style_token_state","render_state","qualitative_state","reason"],"properties":{"archetype_id":{"type":"string","pattern":"^A[0-9]{2}$"},"archetype_source_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"descriptor_refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9-]{2,63}$"}},"measured_metrics":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/metric"}},"structural_geometry":{"enum":["provisional","insufficient_evidence"]},"style_token_state":{"const":"provisional"},"render_state":{"const":"blocked_environment"},"qualitative_state":{"const":"blocked_visual_review"},"reason":{"type":"string","minLength":1,"maxLength":240}}}}}
