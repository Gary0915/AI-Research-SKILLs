{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "layout-plan.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "layout_plan_id", "slide_id", "selected_archetype", "native_template_layout", "placement_plan", "figure_text_hierarchy", "expected_professor_checks", "candidate_alternatives", "rejection_reasons", "warnings", "density_estimate", "split_recommendation", "rationale", "source_event_cursor", "created_at"],
  "properties": {"schema_version": {"const": "2.0.0"}, "layout_plan_id": {"type": "string", "pattern": "^LP-[A-Z0-9-]+$"}, "slide_id": {"type": "string", "pattern": "^S-[A-Z0-9-]+$"}, "selected_archetype": {"type": "string", "pattern": "^A(0[1-9]|1[0-8])$"}, "native_template_layout": {"type": "object", "additionalProperties": false, "required": ["semantic_role", "layout_index", "layout_path", "master_path"], "properties": {"semantic_role": {"type": "string", "minLength": 1}, "layout_index": {"type": "integer", "minimum": 0}, "layout_path": {"type": "string", "pattern": "^ppt/slideLayouts/slideLayout[0-9]+\\.xml$"}, "master_path": {"type": "string", "pattern": "^ppt/slideMasters/slideMaster[0-9]+\\.xml$"}}}, "placement_plan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/placement"}}, "figure_text_hierarchy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "expected_professor_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "candidate_alternatives": {"type": "array", "items": {"type": "string", "pattern": "^A(0[1-9]|1[0-8])$"}}, "rejection_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}, "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}, "density_estimate": {"type": "string", "enum": ["low", "medium", "high", "over_budget"]}, "split_recommendation": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1}, "source_event_cursor": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}, "text_units": {"type": "integer", "minimum": 0}, "text_budget": {"type": "integer", "minimum": 1}, "required_slots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "slot_signature": {"type": "string", "minLength": 1}},
  "$defs": {"placement": {"type": "object", "additionalProperties": false, "required": ["slot", "left", "top", "width", "height", "z_order", "element_role"], "properties": {"slot": {"type": "string", "minLength": 1}, "left": {"type": "number", "minimum": 0}, "top": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "z_order": {"type": "integer", "minimum": 0}, "element_role": {"type": "string", "minLength": 1}, "font_size_pt": {"type": "number", "minimum": 1}}}}
}
