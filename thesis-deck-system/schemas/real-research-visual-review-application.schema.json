{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "real-research-visual-review-application.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["application_id", "logical_fixture_count", "cases", "real_candidate_slide_count", "multi_candidate_fixture_count", "candidate_difference_audit", "fake_candidate_variant_count", "traditional_chinese_primary_language", "invented_scientific_claim_count", "invented_measured_value_count"],
  "properties": {
    "application_id": {"const": "RRVA-PPA-001"}, "logical_fixture_count": {"const": 14},
    "cases": {"type": "array", "minItems": 14, "items": {"$ref": "#/$defs/case"}},
    "real_candidate_slide_count": {"const": 21}, "multi_candidate_fixture_count": {"const": 7},
    "candidate_difference_audit": {"type": "object", "additionalProperties": false, "required": ["records"], "properties": {"records": {"type": "array", "minItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "candidate_a", "candidate_b", "structurally_distinct"], "properties": {"fixture_id": {"pattern": "^R", "type": "string"}, "candidate_a": {"pattern": "^RRVC-", "type": "string"}, "candidate_b": {"pattern": "^RRVC-", "type": "string"}, "structurally_distinct": {"const": true}}}}}},
    "fake_candidate_variant_count": {"const": 0}, "traditional_chinese_primary_language": {"const": "pass"}, "invented_scientific_claim_count": {"const": 0}, "invented_measured_value_count": {"const": 0}
  },
  "$defs": {
    "case": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "logical_slide_id", "slide_id", "title", "fixture", "content_shape", "eligible_layout_capability_count", "candidates", "selected_candidate_id", "body_source_fit_status", "expected_family_purpose"], "properties": {"fixture_id": {"type": "string", "pattern": "^R"}, "logical_slide_id": {"type": "string", "pattern": "^RRVA-R"}, "slide_id": {"type": "string", "pattern": "^RRVA-R"}, "title": {"type": "string", "minLength": 2}, "fixture": {"$ref": "#/$defs/fixture"}, "content_shape": {"$ref": "#/$defs/contentShape"}, "eligible_layout_capability_count": {"type": "integer", "minimum": 1}, "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}, "selected_candidate_id": {"type": "string", "pattern": "^RRVC-"}, "body_source_fit_status": {"const": "pass"}, "expected_family_purpose": {"enum": ["group_meeting_evidence_setup", "tsmc_research_synthesis"]}}},
    "canonicalSourceRefs": {"type": "object", "additionalProperties": false, "required": ["slide_spec_id", "claim_refs", "evidence_refs", "asset_refs", "action_refs", "decision_refs", "source_cursor"], "properties": {"slide_spec_id": {"type": "string", "pattern": "^S-"}, "claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^C"}}, "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^E"}}, "asset_refs": {"type": "array", "items": {"type": "string", "pattern": "^A"}}, "action_refs": {"type": "array", "items": {"type": "string", "pattern": "^N"}}, "decision_refs": {"type": "array", "items": {"type": "string", "pattern": "^D"}}, "source_cursor": {"type": "integer", "minimum": 1}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "logical_slide_id", "title", "visible_text", "traditional_chinese_primary", "body_source_class", "canonical_source_refs", "dependency_hash", "scientific_evidence_status", "source_only_role_indicators", "human_visual_acceptance"], "properties": {"fixture_id": {"type": "string", "pattern": "^R"}, "logical_slide_id": {"type": "string", "pattern": "^RRVA-R"}, "title": {"type": "string"}, "visible_text": {"type": "string"}, "traditional_chinese_primary": {"const": true}, "body_source_class": {"enum": ["group_meeting_dominant", "tsmc_dominant", "hybrid_body", "historical_reuse"]}, "canonical_source_refs": {"$ref": "#/$defs/canonicalSourceRefs"}, "dependency_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "scientific_evidence_status": {"enum": ["canonical_supported", "synthetic_non_evidence"]}, "source_only_role_indicators": {"type": "array", "items": {"type": "string"}}, "human_visual_acceptance": {"const": "not_reviewed"}}},
    "contentShape": {"type": "object", "additionalProperties": false, "required": ["content_shape_id", "slide_id", "semantic_stage", "observations", "text_density_class", "evidence_density_class", "composition_content_items", "content_items_provided", "shape_basis", "content_shape_sha256"], "properties": {"content_shape_id": {"type": "string", "pattern": "^SCS-"}, "slide_id": {"type": "string", "pattern": "^RRVA-R"}, "semantic_stage": {"const": "review_fixture"}, "observations": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"enum": ["value", "unavailable"]}, "value": {"type": ["integer", "null"]}}}}, "text_density_class": {"enum": ["low", "medium", "high"]}, "evidence_density_class": {"enum": ["low", "medium", "high"]}, "composition_content_items": {"type": "array", "items": {"$ref": "#/$defs/contentItem"}}, "content_items_provided": {"const": true}, "shape_basis": {"const": "canonical_slidespec_projection"}, "content_shape_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "body_family_id", "composition_strategy", "body_source_class", "dependency_hash", "structure_fingerprint", "content_items", "algorithm_fit", "candidate_status"], "properties": {"candidate_id": {"type": "string", "pattern": "^RRVC-"}, "body_family_id": {"type": "string", "pattern": "^BCF-"}, "composition_strategy": {"type": "string", "pattern": "^[a-z_]+$"}, "body_source_class": {"enum": ["group_meeting_dominant", "tsmc_dominant", "hybrid_body", "historical_reuse"]}, "dependency_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "structure_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "content_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentItem"}}, "algorithm_fit": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 5}}, "candidate_status": {"const": "eligible"}}},
    "contentItem": {"type": "object", "additionalProperties": false, "required": ["item_id", "semantic_role", "presentation_role", "content_kind", "required"], "properties": {"item_id": {"type": "string", "minLength": 1}, "semantic_role": {"type": "string"}, "presentation_role": {"type": "string"}, "content_kind": {"type": "string"}, "required": {"const": true}, "visible_text": {"type": "string"}}}
  }
}
