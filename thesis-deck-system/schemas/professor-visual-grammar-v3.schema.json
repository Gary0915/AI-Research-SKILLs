{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "professor-visual-grammar-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grammar_id",
    "status",
    "formal_shell_rules",
    "body_composition_rules",
    "active_theme_metadata",
    "active_theme_tokens",
    "typography_tokens",
    "typography_role_grammar",
    "figure_grammar",
    "material_semantic_tokens"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1.0"
    },
    "grammar_id": {
      "const": "PVG003"
    },
    "status": {
      "const": "structural_resolution_only"
    },
    "formal_shell_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shell"
      }
    },
    "body_composition_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "active_theme_metadata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/theme"
      }
    },
    "active_theme_tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/style"
      }
    },
    "typography_tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/type"
      }
    },
    "figure_grammar": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/figure"
      }
    },
    "material_semantic_tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "typography_role_grammar": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/type"
      }
    }
  },
  "$defs": {
    "tier": {
      "enum": [
        "recurring_pattern",
        "single_example_provisional",
        "indirect_supported",
        "insufficient_evidence"
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "value": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "width",
            "height"
          ],
          "properties": {
            "kind": {
              "const": "canvas"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "geometry"
          ],
          "properties": {
            "kind": {
              "const": "geometry"
            },
            "geometry": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "minimum",
            "maximum",
            "center"
          ],
          "properties": {
            "kind": {
              "const": "range"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "center": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rgb",
            "semantic_role",
            "rotation_eligible"
          ],
          "properties": {
            "kind": {
              "const": "color"
            },
            "rgb": {
              "type": "string",
              "pattern": "^[0-9A-F]{6}$"
            },
            "semantic_role": {
              "enum": [
                "neutral",
                "accent",
                "emphasis",
                "unknown"
              ]
            },
            "rotation_eligible": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "orientation",
            "directedness",
            "head_marker",
            "tail_marker",
            "rotation_eligible"
          ],
          "properties": {
            "kind": {
              "const": "connector"
            },
            "orientation": {
              "enum": [
                "horizontal",
                "vertical",
                "diagonal",
                "unknown"
              ]
            },
            "directedness": {
              "enum": [
                "directed",
                "plain",
                "unknown"
              ]
            },
            "head_marker": {
              "enum": [
                "none",
                "triangle",
                "unknown"
              ]
            },
            "tail_marker": {
              "enum": [
                "none",
                "triangle",
                "unknown"
              ]
            },
            "rotation_eligible": {
              "const": true
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_scope",
        "occurrence_count",
        "source_container_count",
        "eligible_container_count",
        "coverage_ratio",
        "supporting_source_ids"
      ],
      "properties": {
        "source_scope": {
          "type": "string"
        },
        "occurrence_count": {
          "type": "integer"
        },
        "source_container_count": {
          "type": "integer"
        },
        "eligible_container_count": {
          "type": "integer"
        },
        "coverage_ratio": {
          "type": "number"
        },
        "supporting_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_id",
        "token_family",
        "value",
        "profile_id",
        "source_role",
        "supporting_ids",
        "support_count",
        "support_by_scope",
        "variants",
        "evidence_tier",
        "resolver_rule_id",
        "authority_family",
        "origin"
      ],
      "properties": {
        "token_id": {
          "type": "string"
        },
        "token_family": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "profile_id": {
          "enum": [
            "P3-TEMPLATE-PRIMARY-1",
            "P3-TEMPLATE-PRIMARY-3"
          ]
        },
        "source_role": {
          "enum": [
            "P3-TEMPLATE-PRIMARY-1",
            "P3-TEMPLATE-PRIMARY-3"
          ]
        },
        "supporting_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "support_count": {
          "type": "integer",
          "minimum": 0
        },
        "support_by_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region_id",
              "value",
              "supporting_ids"
            ],
            "properties": {
              "region_id": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/value"
              },
              "supporting_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "evidence_tier": {
          "$ref": "#/$defs/tier"
        },
        "resolver_rule_id": {
          "type": "string"
        },
        "authority_family": {
          "const": "formal_shell"
        },
        "origin": {
          "enum": [
            "professor_derived",
            "unresolved"
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "availability",
        "observed_range",
        "robust_center",
        "sample_count",
        "preferred_descriptor_id",
        "outlier_descriptor_ids"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "observed_range": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          }
        },
        "robust_center": {
          "type": [
            "number",
            "null"
          ]
        },
        "sample_count": {
          "type": "integer"
        },
        "preferred_descriptor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "outlier_descriptor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "family",
        "source_role",
        "source_profile_id",
        "supporting_descriptor_ids",
        "sample_count",
        "source_confidence",
        "evidence_tier",
        "metric_distributions",
        "preferred_descriptor_id",
        "outlier_descriptor_ids",
        "unavailable_metrics",
        "representative_method",
        "status"
      ],
      "properties": {
        "family_id": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "source_role": {
          "const": "P3-LAYOUT-EXEMPLAR-2"
        },
        "source_profile_id": {
          "const": "P3-LAYOUT-EXEMPLAR-2"
        },
        "supporting_descriptor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sample_count": {
          "type": "integer"
        },
        "source_confidence": {
          "type": "string"
        },
        "evidence_tier": {
          "$ref": "#/$defs/tier"
        },
        "metric_distributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "preferred_descriptor_id": {
          "type": "string"
        },
        "outlier_descriptor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unavailable_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "representative_method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method_id",
            "comparable_metric_count",
            "missing_data_penalty",
            "outlier_method_id"
          ],
          "properties": {
            "method_id": {
              "const": "CP3-NORMALIZED-PAIRWISE-MEDOID-V1"
            },
            "comparable_metric_count": {
              "type": "integer"
            },
            "missing_data_penalty": {
              "type": "number"
            },
            "outlier_method_id": {
              "const": "CP3-MAD-OUTLIER-V1"
            }
          }
        },
        "status": {
          "enum": [
            "resolved",
            "provisional",
            "insufficient"
          ]
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_id",
        "profile_id",
        "theme_profile_id",
        "usage_state",
        "authority_state",
        "palette",
        "status"
      ],
      "properties": {
        "metadata_id": {
          "type": "string"
        },
        "profile_id": {
          "enum": [
            "P3-TEMPLATE-PRIMARY-1",
            "P3-TEMPLATE-PRIMARY-3",
            "P3-LAYOUT-EXEMPLAR-2"
          ]
        },
        "theme_profile_id": {
          "type": "string"
        },
        "usage_state": {
          "const": "referenced"
        },
        "authority_state": {
          "const": "active_professor_style"
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "theme_token",
              "resolved_rgb"
            ],
            "properties": {
              "theme_token": {
                "type": "string"
              },
              "resolved_rgb": {
                "type": "string",
                "pattern": "^[0-9A-F]{6}$"
              }
            }
          }
        },
        "status": {
          "const": "reference_metadata"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_id",
        "value",
        "origin",
        "evidence_tier",
        "source_role",
        "source_scope",
        "supporting_ids",
        "resolver_rule_id",
        "authority_family",
        "status"
      ],
      "properties": {
        "token_id": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "origin": {
          "enum": [
            "professor_derived",
            "phase2_fallback",
            "implementation_fallback",
            "unresolved"
          ]
        },
        "evidence_tier": {
          "$ref": "#/$defs/tier"
        },
        "source_role": {
          "type": "string"
        },
        "source_scope": {
          "type": "string"
        },
        "supporting_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolver_rule_id": {
          "type": "string"
        },
        "authority_family": {
          "enum": [
            "formal_shell",
            "body_composition",
            "implementation"
          ]
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_id",
        "role",
        "role_confidence",
        "family",
        "font_evidence_state",
        "script_role",
        "size_pt",
        "weight",
        "style",
        "source_role",
        "source_profile_id",
        "source_scope",
        "supporting_ids",
        "evidence_tier",
        "origin",
        "resolver_rule_id",
        "family_alternatives",
        "size_range",
        "supporting_container_ids",
        "supporting_slide_ids",
        "independent_support_count",
        "status"
      ],
      "properties": {
        "token_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "role_confidence": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "font_evidence_state": {
          "enum": [
            "explicit_font",
            "theme_font_resolved"
          ]
        },
        "script_role": {
          "enum": [
            "latin",
            "east_asian",
            "complex_script"
          ]
        },
        "size_pt": {
          "type": "number"
        },
        "weight": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "source_role": {
          "enum": [
            "P3-TEMPLATE-PRIMARY-1",
            "P3-TEMPLATE-PRIMARY-3",
            "P3-LAYOUT-EXEMPLAR-2"
          ]
        },
        "source_profile_id": {
          "type": "string"
        },
        "source_scope": {
          "type": "string"
        },
        "supporting_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_tier": {
          "$ref": "#/$defs/tier"
        },
        "origin": {
          "const": "professor_derived"
        },
        "resolver_rule_id": {
          "type": "string"
        },
        "family_alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "size_range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "supporting_container_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "supporting_slide_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SL[0-9]{3,}$"
          }
        },
        "independent_support_count": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "resolved",
            "insufficient"
          ]
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_id",
        "token_family",
        "metric",
        "family",
        "value",
        "origin",
        "evidence_tier",
        "source_role",
        "source_scope",
        "supporting_ids",
        "resolver_rule_id"
      ],
      "properties": {
        "token_id": {
          "type": "string"
        },
        "token_family": {
          "enum": [
            "figure_metric",
            "style_color",
            "connector"
          ]
        },
        "metric": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "origin": {
          "const": "professor_derived"
        },
        "evidence_tier": {
          "$ref": "#/$defs/tier"
        },
        "source_role": {
          "enum": [
            "P3-TEMPLATE-PRIMARY-1",
            "P3-TEMPLATE-PRIMARY-3",
            "P3-LAYOUT-EXEMPLAR-2"
          ]
        },
        "source_scope": {
          "type": "string"
        },
        "supporting_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolver_rule_id": {
          "type": "string"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_id",
        "status",
        "origin",
        "evidence_tier"
      ],
      "properties": {
        "token_id": {
          "type": "string"
        },
        "status": {
          "const": "unresolved"
        },
        "origin": {
          "const": "unresolved"
        },
        "evidence_tier": {
          "const": "insufficient_evidence"
        }
      }
    }
  }
}
