{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"scientific-svg-identity.schema.json","type":"object","additionalProperties":false,"required":["schema_version","figure_id","profile_id","profile_version","canonicalization_version","source_sha256","canonical_sha256","canonical_svg"],"properties":{"schema_version":{"const":"1.0.0"},"figure_id":{"type":"string","pattern":"^FIG[0-9]{3,}$"},"profile_id":{"type":"string","pattern":"^SSVG-P[0-9]{3}$"},"profile_version":{"const":"1.0.0"},"canonicalization_version":{"const":"1.0.0"},"source_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"canonical_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"canonical_svg":{"type":"string","minLength":1}}}
