{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "sanitized-body-structural-descriptors.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "descriptor"],
  "properties": {"schema_version": {"const": "1.0.0"}, "descriptor": {"$ref": "#/$defs/descriptor"}},
  "$defs": {
    "geometry": {"type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h", "basis"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}},
    "style": {"type": "object", "additionalProperties": false, "required": ["fill_role", "stroke_role", "line_width_pt", "basis"], "properties": {"fill_role": {"enum": ["none", "background", "neutral", "accent", "emphasis", "unknown"]}, "stroke_role": {"enum": ["none", "neutral", "accent", "emphasis", "unknown"]}, "line_width_pt": {"type": "number", "minimum": 0, "maximum": 20}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["object_id", "object_class", "primitive_type", "geometry", "group_id", "style", "basis"], "properties": {"object_id": {"type": "string", "pattern": "^O[0-9]{3,}$"}, "object_class": {"enum": ["text", "picture", "table", "chart", "native_shape", "connector", "group", "line", "unknown"]}, "primitive_type": {"enum": ["textbox", "picture", "table", "chart", "rect", "round_rect", "ellipse", "line", "arrow", "group", "unknown"]}, "geometry": {"$ref": "#/$defs/geometry"}, "group_id": {"type": ["string", "null"]}, "style": {"$ref": "#/$defs/style"}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}},
    "connector": {"type": "object", "additionalProperties": false, "required": ["object_id", "orientation", "start", "end", "basis"], "properties": {"object_id": {"type": "string", "pattern": "^O[0-9]{3,}$"}, "orientation": {"enum": ["horizontal", "vertical", "diagonal", "unknown"]}, "start": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "minItems": 2, "maxItems": 2}, "end": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "minItems": 2, "maxItems": 2}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}},
    "panel": {"type": "object", "additionalProperties": false, "required": ["panel_id", "geometry", "basis"], "properties": {"panel_id": {"type": "string", "pattern": "^P[0-9]{3,}$"}, "geometry": {"$ref": "#/$defs/geometry"}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["family", "confidence", "evidence_basis"], "properties": {"family": {"enum": ["formal_shell_divider", "hypothesis_problem", "photo_schematic", "control_proposed_comparison", "experiment_schematic", "result_single", "result_comparison", "result_discussion", "image_matrix", "fishbone_research_map", "fabrication_process_flow", "other_insufficient_structural_evidence"]}, "confidence": {"enum": ["structurally_supported", "provisional", "insufficient_structural_evidence"]}, "evidence_basis": {"type": "array", "items": {"enum": ["picture_geometry", "text_geometry", "panel_geometry", "connector_geometry", "shape_style", "group_structure", "insufficient"]}}}},
    "measurement": {"type": "object", "additionalProperties": false, "required": ["slide_id", "measurement_basis", "objects", "connectors", "groups", "panels", "metrics", "style_roles"], "properties": {"slide_id": {"type": "string", "pattern": "^SL[0-9]{3,}$"}, "measurement_basis": {"enum": ["measured", "derived", "not_observable_structurally"]}, "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}}, "connectors": {"type": "array", "items": {"$ref": "#/$defs/connector"}}, "groups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["group_id", "member_count", "basis"], "properties": {"group_id": {"type": "string", "pattern": "^G[0-9]{3,}$"}, "member_count": {"type": "integer", "minimum": 1}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}}}, "panels": {"type": "array", "items": {"$ref": "#/$defs/panel"}}, "metrics": {"type": "object", "additionalProperties": false, "required": ["text_area_ratio", "figure_area_ratio", "dominant_figure_ratio", "figure_text_ratio", "annotation_density", "whitespace_fraction", "comparison_symmetry", "matrix_rows", "matrix_columns", "panel_count", "caption_candidate_count", "callout_candidate_count", "photo_schematic_relation", "basis"], "properties": {"text_area_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "figure_area_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "dominant_figure_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "figure_text_ratio": {"type": "number", "minimum": 0}, "annotation_density": {"type": "number", "minimum": 0}, "whitespace_fraction": {"type": "number", "minimum": 0, "maximum": 1}, "comparison_symmetry": {"type": "number", "minimum": 0, "maximum": 1}, "matrix_rows": {"type": "integer", "minimum": 0}, "matrix_columns": {"type": "integer", "minimum": 0}, "panel_count": {"type": "integer", "minimum": 0}, "caption_candidate_count": {"type": "integer", "minimum": 0}, "callout_candidate_count": {"type": "integer", "minimum": 0}, "photo_schematic_relation": {"enum": ["adjacent", "overlapping", "none", "unknown"]}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}}, "style_roles": {"type": "array", "items": {"$ref": "#/$defs/style"}}}},
    "descriptor": {"type": "object", "additionalProperties": false, "required": ["alias_uri", "source_sha256", "profile_id", "slide_size", "slide_count", "candidate_families", "body_measurements"], "properties": {"alias_uri": {"const": "private://layout_exemplar_2"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "profile_id": {"type": "string", "pattern": "^P3-[A-Z0-9-]+$"}, "slide_size": {"type": "object", "additionalProperties": false, "required": ["width", "height", "basis"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "basis": {"enum": ["measured", "derived", "not_observable_structurally"]}}}, "slide_count": {"type": "integer", "minimum": 1}, "candidate_families": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}, "body_measurements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measurement"}}}}
  }
}
