{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "next-step.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "action_item_id", "revision", "action_type", "title", "action", "rationale", "source_decision_ref", "linked_block_refs", "linked_claim_refs", "prior_commitment", "owner", "target_window", "actual_completion", "success_failure_criteria", "required_evidence", "dependency_refs", "blocker_refs", "parallelizable", "workstream", "status", "provenance", "created_at", "updated_at"],
  "properties": {"schema_version": {"const": "1.0.0"}, "action_item_id": {"type": "string", "pattern": "^NS[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1}, "action_type": {"type": "string", "enum": ["experiment", "analysis", "literature", "fabrication", "decision"]}, "title": {"type": "string"}, "action": {"type": "string", "minLength": 3}, "rationale": {"type": "string", "minLength": 3}, "source_decision_ref": {"type": "string", "pattern": "^D[0-9]{3,}$"}, "linked_block_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block_ref"}}, "linked_claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3,}$"}}, "prior_commitment": {"type": "object", "additionalProperties": false, "required": ["meeting_id", "committed_at"], "properties": {"meeting_id": {"type": "string"}, "committed_at": {"type": "string", "format": "date-time"}}}, "owner": {"type": "object", "additionalProperties": false, "required": ["actor_id", "display_name"], "properties": {"actor_id": {"type": "string"}, "display_name": {"type": "string"}}}, "target_window": {"type": "object", "additionalProperties": false, "required": ["start", "due", "timezone"], "properties": {"start": {"type": "string", "format": "date-time"}, "due": {"type": "string", "format": "date-time"}, "timezone": {"type": "string"}}}, "actual_completion": {"type": "object", "additionalProperties": false, "required": ["completed_at", "closure_evidence_refs"], "properties": {"completed_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}, "closure_evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}}}}, "success_failure_criteria": {"type": "object", "additionalProperties": false, "required": ["success", "failure"], "properties": {"success": {"type": "string"}, "failure": {"type": "string"}}}, "required_evidence": {"type": "array", "items": {"type": "string"}}, "dependency_refs": {"type": "array", "items": {"type": "string"}}, "blocker_refs": {"type": "array", "items": {"type": "string"}}, "parallelizable": {"type": "boolean"}, "workstream": {"type": "string"}, "status": {"type": "string", "enum": ["planned", "in_progress", "blocked", "done", "cancelled", "superseded"]}, "result_summary": {"type": ["string", "null"]}, "supersedes": {"type": "array", "items": {"type": "string", "pattern": "^NS[0-9]{3,}$"}}, "superseded_by": {"type": "array", "items": {"type": "string", "pattern": "^NS[0-9]{3,}$"}}, "provenance": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}},
  "$defs": {"block_ref": {"type": "object", "additionalProperties": false, "required": ["block_id", "revision"], "properties": {"block_id": {"type": "string", "pattern": "^B[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1}}}}
}
