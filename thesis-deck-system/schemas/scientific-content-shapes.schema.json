{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://thesis-deck-system.local/schemas/scientific-content-shapes.schema.json","type":"object","additionalProperties":false,"required":["planner_version","records"],"properties":{"planner_version":{"const":"1.0.0"},"records":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/record"}}},"$defs":{"observation":{"type":"object","additionalProperties":false,"required":["state","value"],"properties":{"state":{"enum":["value","unavailable","not_applicable"]},"value":{"type":["integer","null"],"minimum":0}},"allOf":[{"if":{"properties":{"state":{"const":"value"}}},"then":{"properties":{"value":{"type":"integer","minimum":0}}}},{"if":{"properties":{"state":{"enum":["unavailable","not_applicable"]}}},"then":{"properties":{"value":{"const":null}}}}]},"record":{"type":"object","additionalProperties":false,"required":["content_shape_id","slide_id","semantic_stage","observations","text_density_class","evidence_density_class","shape_basis","content_shape_sha256"],"properties":{"content_shape_id":{"type":"string","pattern":"^SCS-[A-F0-9]{16}$"},"slide_id":{"type":"string","minLength":1},"semantic_stage":{"type":"string","minLength":1},"observations":{"type":"object","additionalProperties":{"$ref":"#/$defs/observation"},"minProperties":20},"text_density_class":{"enum":["low","medium","high","unavailable"]},"evidence_density_class":{"enum":["low","medium","high","unavailable"]},"shape_basis":{"const":"canonical_slidespec_projection"},"content_shape_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
